---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<Layout title="Proyectos & Casos de Éxito | René Villegas Carreño">
  <main class="max-w-5xl mx-auto px-6 py-16">
    <div class="mb-12">
      <p class="text-brand-accent font-mono text-sm mb-2">Portafolio Técnico</p>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Proyectos & Casos de Éxito</h1>
      <p class="text-slate-400 max-w-2xl text-base">
        Implementaciones en entornos de alta disponibilidad, proyectos de automatización operativa y optimización de infraestructura de misión crítica.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <div class="bg-brand-card p-6 md:p-8 rounded-xl border border-slate-800 hover:border-brand-accent/50 transition-all shadow-md flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-mono text-brand-accent px-2 py-0.5 rounded bg-brand-accent/10 border border-brand-accent/20">
                {project.data.category}
              </span>
              {project.data.date && (
                <span class="text-xs font-mono text-slate-400">{project.data.date}</span>
              )}
            </div>
            <h2 class="text-xl font-bold text-white group-hover:text-brand-accent transition-colors mb-3">
              {project.data.title}
            </h2>
            <p class="text-slate-400 text-sm leading-relaxed mb-6">
              {project.data.description}
            </p>
          </div>
          
          <div class="flex flex-wrap gap-2 pt-4 border-t border-slate-800/80">
            {project.data.tags.map((tag) => (
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-slate-900 text-slate-300 border border-slate-800">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout>
