---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="Blog Técnico | René Villegas Carreño">
  <main class="max-w-5xl mx-auto px-6 py-16">
    <div class="mb-12">
      <p class="text-brand-accent font-mono text-sm mb-2">Artículos & Análisis</p>
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Blog Técnico</h1>
      <p class="text-slate-400 max-w-2xl text-base">
        Reflexiones, guías técnicas y mejores prácticas sobre gestión de Data Centers, continuidad de negocio, ITIL v4 y automatización con Python/SQL.
      </p>
    </div>

    <div class="grid gap-6">
      {posts.map((post) => (
        <article class="bg-brand-card p-6 md:p-8 rounded-xl border border-slate-800 hover:border-brand-accent/50 transition-all shadow-md group">
          <div class="flex items-center gap-4 text-xs font-mono text-slate-400 mb-3">
            <span>{post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            <span>•</span>
            <span class="text-brand-accent">{post.data.author}</span>
          </div>
          <h2 class="text-2xl font-bold text-white group-hover:text-brand-accent transition-colors mb-3">
            {post.data.title}
          </h2>
          <p class="text-slate-400 text-sm leading-relaxed mb-4">
            {post.data.description}
          </p>
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-slate-900 text-slate-300 border border-slate-800">
                #{tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>
