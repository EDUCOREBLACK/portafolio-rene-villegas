---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="Blog Técnico | René Villegas Carreño">
  <main class="max-w-5xl mx-auto px-6 py-16">
    <div class="mb-12">
      <p class="text-xs font-mono uppercase tracking-widest text-brand-accent mb-2">Artículos & Análisis</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-brand-text mb-4">Blog Técnico</h1>
      <p class="text-sm text-brand-muted max-w-2xl leading-relaxed">
        Artículos, análisis y mejores prácticas sobre gobernanza técnica, gestión de operaciones bajo marco ITIL, resiliencia y automatización con Python y SQL.
      </p>
    </div>

    <div class="grid gap-6">
      {posts.map((post) => (
        <article class="bg-brand-card p-6 sm:p-8 rounded-xl border border-brand-border hover:border-brand-borderHover hover:bg-brand-cardHover transition-all duration-200 group">
          <div class="flex items-center gap-3 text-xs font-mono text-brand-muted mb-3">
            <span>{post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            <span>•</span>
            <span class="text-brand-text">{post.data.author}</span>
          </div>
          <h2 class="text-xl font-bold text-brand-text group-hover:text-brand-accent transition-colors mb-3">
            {post.data.title}
          </h2>
          <p class="text-sm text-brand-muted leading-relaxed mb-4">
            {post.data.description}
          </p>
          <div class="flex flex-wrap gap-1.5">
            {post.data.tags.map((tag) => (
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-brand-bg text-brand-muted border border-brand-border">
                #{tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </main>
</Layout>
