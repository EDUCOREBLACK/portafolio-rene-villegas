---
interface Props {
	title: string;
	description?: string;
}

const { 
  title, 
  description = "Portal Profesional de René Villegas Carreño - Ingeniero en TI, Infraestructura Crítica 24/7, Continuidad Operacional & Automatización con IA" 
} = Astro.props;

import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import CliDownloadModal from '../components/CliDownloadModal.astro';
import Analytics from '@vercel/analytics/astro';
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="author" content="René Villegas Carreño" />
		<meta name="theme-color" content="#020617" />
		<meta name="robots" content="index, follow" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<Analytics />

		<!-- Theme Init Script (Zero FOUC & System Preference Detection) -->
		<script is:inline>
			(() => {
				const storedTheme = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
				let activeTheme = 'dark'; // Dark mode por defecto (Cyber Data Center SOC)

				if (storedTheme === 'light' || storedTheme === 'dark') {
					activeTheme = storedTheme;
				} else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
					activeTheme = 'light';
				}

				if (activeTheme === 'light') {
					document.documentElement.classList.remove('dark');
				} else {
					document.documentElement.classList.add('dark');
				}

				// Listen for system theme changes if user hasn't explicitly set a preference
				if (window.matchMedia) {
					window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
						if (!localStorage.getItem('theme')) {
							if (e.matches) {
								document.documentElement.classList.remove('dark');
							} else {
								document.documentElement.classList.add('dark');
							}
						}
					});
				}
			})();
		</script>
	</head>
	<body class="min-h-screen flex flex-col antialiased font-sans transition-colors duration-200">
		<Navbar />
		
		<div class="flex-1">
			<slot />
		</div>

		<!-- CLI Download Modal (Square popup terminal window) -->
		<CliDownloadModal />

		<!-- Cyber SOC / Corporate Footer -->
		<footer class="border-t border-slate-800 dark:border-slate-800/80 border-slate-200 py-12 text-center text-xs text-slate-400 dark:text-slate-400 font-mono mt-16 transition-colors">
			<div class="max-w-5xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
				<p>© {new Date().getFullYear()} René Villegas Carreño. Desplegado con CI/CD en Vercel.</p>
				<div class="flex flex-wrap items-center justify-center gap-5">
					<a href="https://github.com/EDUCOREBLACK" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 dark:hover:text-cyan-400 hover:text-blue-600 transition-colors">
						GitHub
					</a>
					<a href="https://www.linkedin.com/in/rene-eduardo-villegas-carreño-471a94140" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 dark:hover:text-cyan-400 hover:text-blue-600 transition-colors">
						LinkedIn
					</a>
					<a href="mailto:Duarapcsis@gmail.com" class="hover:text-cyan-400 dark:hover:text-cyan-400 hover:text-blue-600 transition-colors">
						Duarapcsis@gmail.com
					</a>
					<button 
						type="button"
						data-open-cli-download
						class="text-cyan-400 dark:text-cyan-400 text-blue-600 hover:underline font-semibold cursor-pointer"
					>
						Descargar CV (CLI)
					</button>
				</div>
			</div>
		</footer>
	</body>
</html>
