---
const services = [
  {
    number: "01",
    title: "Infraestructura, Montaje & Configuración",
    description: "Instalación física de servidores y equipamiento de red en racks. Cableado estructurado y canalizaciones de fibra óptica. Configuración inicial de switches, routers y sistemas de climatización y energía para salas de cómputo.",
    tags: ["Instalación Física", "Montaje en Rack", "Fibra & Cobre", "Networking", "Climatización & Energía"]
  },
  {
    number: "02",
    title: "Desarrollo de Aplicaciones a Medida",
    description: "Diseño y construcción de software empresarial adaptado a las necesidades específicas de la organización: sistemas de inventario, plataformas de gestión interna, APIs REST seguras y paneles de control con bases de datos relacionales.",
    tags: ["Desarrollo Web", "APIs REST", "SQL / Bases de Datos", "Python", "TypeScript"]
  },
  {
    number: "03",
    title: "Automatización de Procesos con IA",
    description: "Implementación de flujos de trabajo inteligentes con agentes de Inteligencia Artificial para procesamiento automático de datos, conciliación de registros, reportes ejecutivos en Power BI y reducción de tareas manuales repetitivas.",
    tags: ["Agentes de IA", "Automatización de Flujos", "Power BI", "Python Scripting", "Integración de Modelos"]
  },
  {
    number: "04",
    title: "Landing Pages, WordPress & E-Commerce",
    description: "Creación de sitios web y páginas de aterrizaje de alta conversión. Implementación y personalización de soluciones en WordPress y plataformas de comercio electrónico (E-commerce) seguras, rápidas y optimizadas para móviles.",
    tags: ["Landing Pages", "WordPress", "E-Commerce", "Diseño Responsivo", "SEO & Rendimiento"]
  },
  {
    number: "05",
    title: "Soporte TI & Mantenimiento Computacional",
    description: "Servicio integral de mantención preventiva y correctiva para parques computacionales de empresas. Diagnóstico de hardware, optimización de sistemas operativos Windows/Linux, seguridad y asistencia técnica continua.",
    tags: ["Soporte Empresas", "Mantención Preventiva", "Hardware PC & Laptops", "Windows / Linux", "Respaldo & Seguridad"]
  }
];
---

<section id="servicios" class="max-w-5xl mx-auto px-6 py-20 border-t border-brand-border">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
    <div>
      <p class="text-xs font-mono uppercase tracking-widest text-brand-accent mb-2">Servicios Técnicos & Consultoría</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-brand-text">Soluciones TI Integrales</h2>
    </div>
    <p class="text-sm text-brand-muted max-w-md">
      Servicios especializados orientados tanto a infraestructura física de misión crítica como a software, automatización con IA y soporte corporativo.
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    {services.map((service, index) => (
      <div class={`bg-brand-card p-6 sm:p-7 rounded-xl border border-brand-border hover:border-brand-borderHover hover:bg-brand-cardHover transition-all duration-200 flex flex-col justify-between group ${index === 0 ? 'lg:col-span-1' : ''}`}>
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono text-brand-accent font-semibold">
              /{service.number}
            </span>
            <span class="w-1.5 h-1.5 rounded-full bg-brand-border group-hover:bg-brand-accent transition-colors"></span>
          </div>
          
          <h3 class="text-lg font-bold text-brand-text mb-3 group-hover:text-white transition-colors">
            {service.title}
          </h3>
          <p class="text-xs sm:text-sm text-brand-muted leading-relaxed mb-6">
            {service.description}
          </p>
        </div>

        <div class="flex flex-wrap gap-1.5 pt-4 border-t border-brand-border/60">
          {service.tags.map((tag) => (
            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-brand-bg text-brand-muted border border-brand-border">
              {tag}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
