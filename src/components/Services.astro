---
const services = [
  {
    number: "01",
    title: "Infraestructura, Montaje & Configuración",
    description: "Instalación física de servidores y switches en racks corporativos. Cableado estructurado categoría 6A/7 y canalizaciones de fibra óptica. Puesta en marcha de equipamiento de networking, energía ininterrumpida (UPS) y climatización.",
    tags: ["Instalación Física", "Montaje en Rack", "Fibra & Cobre", "Networking", "Energía & Climatización"]
  },
  {
    number: "02",
    title: "Desarrollo de Software & Aplicaciones a Medida",
    description: "Diseño y desarrollo de sistemas empresariales adaptados a las necesidades operativas de la compañía: inventarios de activos, plataformas web con PHP/Python/JS, APIs RESTful seguras y bases de datos optimizadas.",
    tags: ["Desarrollo Web", "APIs REST", "SQL / NoSQL", "Python & Django", "Laravel & Yii2"]
  },
  {
    number: "03",
    title: "Automatización de Procesos con IA",
    description: "Implementación de flujos de trabajo inteligentes con agentes de Inteligencia Artificial para procesamiento automático de datos, conciliación de registros, reportes analíticos y reducción de fricción operativa.",
    tags: ["Agentes de IA", "Automatización de Flujos", "Power BI", "Python Scripting", "Integración LLM"]
  },
  {
    number: "04",
    title: "Landing Pages, WordPress & E-Commerce",
    description: "Construcción de sitios web corporativos y páginas de aterrizaje de alta conversión. Implementación, personalización y soporte continuo en WordPress y plataformas de comercio electrónico seguras y rápidas.",
    tags: ["Landing Pages", "WordPress", "E-Commerce", "Diseño Responsivo", "Rendimiento & SEO"]
  },
  {
    number: "05",
    title: "Soporte TI & Mantenimiento Computacional",
    description: "Servicio integral de mantención preventiva y correctiva para parques computacionales de empresas. Diagnóstico de fallas de hardware, soporte N1/N2/N3 en Windows/Linux, respaldos y ciberseguridad perimetral.",
    tags: ["Soporte Corporativo", "Mantención Preventiva", "Hardware PC & Laptops", "Windows / Linux", "Seguridad"]
  }
];
---

<section id="servicios" class="max-w-5xl mx-auto px-6 py-16 border-t border-zinc-200 dark:border-white/10 transition-colors reveal">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
    <div>
      <div class="inline-flex items-center gap-2 mb-2 font-mono text-xs uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400 font-semibold">
        <span>●</span>
        <span>Servicios Técnicos & Consultoría</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-heading font-bold text-zinc-950 dark:text-white tracking-tight">
        Soluciones TI Integrales
      </h2>
    </div>
    <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-md leading-relaxed">
      Especialización en continuidad operacional de centros de datos, desarrollo a medida, automatizaciones con IA y soporte corporativo 24/7.
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
    {services.map((service, index) => (
      <div class={`pro-card p-6 rounded-2xl flex flex-col justify-between group ${index === 0 ? 'lg:col-span-1' : ''} reveal ${index > 0 ? 'reveal-delay-' + (index % 3 + 1) : ''}`}>
        <div>
          <div class="flex items-center justify-between mb-5">
            <span class="text-xs font-mono font-bold text-zinc-950 dark:text-white bg-zinc-100 dark:bg-white/10 px-3 py-1 rounded-full border border-zinc-200 dark:border-white/15">
              /{service.number}
            </span>
            <span class="w-2 h-2 rounded-full bg-zinc-300 dark:bg-zinc-700 group-hover:bg-zinc-950 dark:group-hover:bg-white transition-colors"></span>
          </div>
          
          <h3 class="text-base font-bold text-zinc-950 dark:text-white mb-2.5 group-hover:text-zinc-700 dark:group-hover:text-zinc-300 transition-colors">
            {service.title}
          </h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed mb-6">
            {service.description}
          </p>
        </div>

        <div class="flex flex-wrap gap-1.5 pt-4 border-t border-zinc-200 dark:border-white/10">
          {service.tags.map((tag) => (
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-white/5 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-white/10">
              {tag}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
