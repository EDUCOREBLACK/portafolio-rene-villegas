---
---
<!-- CLI Download Terminal Modal (El cuadrado interactivo para descarga de CV) -->
<div 
  id="cli-download-modal" 
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cli-modal-title"
>
  <!-- Modal Card (Terminal Box) -->
  <div 
    id="cli-modal-box"
    class="w-full max-w-xl bg-gray-950/95 border border-gray-800 rounded-2xl shadow-2xl overflow-hidden font-mono transform scale-95 transition-transform duration-300 relative text-xs"
  >
    <!-- Top Accent Gradient Line -->
    <div class="h-1 w-full bg-gradient-to-r from-cyan-500 via-blue-500 to-emerald-400"></div>

    <!-- Terminal Titlebar -->
    <div class="bg-gray-900/90 px-4 py-3 flex items-center justify-between border-b border-gray-800 select-none">
      <div class="flex items-center gap-2">
        <button id="cli-close-circle" class="w-3 h-3 rounded-full bg-red-500 hover:brightness-125 transition-all inline-block" title="Cerrar (Esc)"></button>
        <span class="w-3 h-3 rounded-full bg-yellow-500 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span>
        <span id="cli-modal-title" class="text-[11px] text-gray-400 font-mono ml-2">
          bash — rene@datacenter-core: ~/download_cv.sh
        </span>
      </div>
      
      <div class="flex items-center gap-2">
        <span class="text-[10px] text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-800/50 flex items-center gap-1 font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          HTTPS 200 OK
        </span>
        <button 
          id="cli-modal-close-btn" 
          class="text-gray-400 hover:text-white p-1 rounded hover:bg-gray-800 transition-colors"
          title="Cerrar modal (Esc)"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Terminal Console Content -->
    <div class="p-5 space-y-3 bg-gray-950 text-gray-200 min-h-[300px] max-h-[460px] overflow-y-auto leading-relaxed">
      <!-- Simulated command line -->
      <div class="flex items-center gap-2 text-cyan-400">
        <span class="text-emerald-400 font-bold">rene@datacenter:~$</span>
        <span class="text-white font-semibold">curl -fsSL https://renevillegas.dev/cv-rene-villegas.pdf -o CV_Rene_Villegas.pdf --verbose</span>
      </div>

      <!-- Output logs container -->
      <div id="cli-output-log" class="space-y-2 pt-1 text-gray-300">
        <div class="text-gray-500 text-[11px]">* Connected to renevillegas.dev (104.21.72.10) port 443 (#0)</div>
        <div class="text-gray-500 text-[11px]">* TLS 1.3 connection established with ALPN: h2</div>
        <div class="text-cyan-300 text-[11px]">&gt; GET /cv-rene-villegas.pdf HTTP/2</div>
        <div class="text-emerald-400 text-[11px]">&lt; HTTP/2 200 OK</div>
        <div class="text-gray-400 text-[11px]">&lt; Content-Type: application/pdf</div>
        <div class="text-gray-400 text-[11px]">&lt; Content-Length: 584,141 bytes (584 KB)</div>
        <div class="text-gray-400 text-[11px]">&lt; Cache-Control: public, max-age=31536000, immutable</div>
        
        <!-- Progress bar simulation -->
        <div class="pt-2">
          <div class="flex justify-between text-[11px] text-gray-400 mb-1">
            <span id="cli-progress-status">Transfiriendo bytes seguros...</span>
            <span id="cli-progress-percent" class="text-emerald-400 font-bold">0%</span>
          </div>
          <div class="w-full bg-gray-800 rounded-full h-2.5 overflow-hidden border border-gray-700">
            <div id="cli-progress-bar" class="bg-gradient-to-r from-cyan-500 via-blue-500 to-emerald-400 h-2.5 rounded-full w-0 transition-all duration-300"></div>
          </div>
        </div>

        <!-- SHA256 integrity check -->
        <div id="cli-integrity-msg" class="text-[11px] text-gray-500 hidden pt-1">
          * SHA-256: <span class="text-cyan-300">e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855</span> (OK)
        </div>

        <!-- Final success message -->
        <div id="cli-complete-msg" class="pt-3 border-t border-gray-800/80 hidden">
          <p class="text-emerald-400 font-semibold flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            ¡Descarga de CV completada con éxito!
          </p>
          <p class="text-gray-400 text-[11px] mt-1">
            El documento <strong class="text-white">Curriculum_Vitae_Rene_Villegas.pdf</strong> ha sido transferido a tu equipo.
          </p>
        </div>
      </div>
    </div>

    <!-- Terminal Footer Actions -->
    <div class="bg-gray-900/80 px-4 py-3 border-t border-gray-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px]">
      <div class="text-gray-400">
        ¿No inició la descarga? 
        <a 
          id="cli-manual-download-link"
          href="/cv-rene-villegas.pdf" 
          download="Curriculum_Vitae_Rene_Villegas.pdf"
          class="text-cyan-400 hover:text-cyan-300 underline font-semibold ml-1"
        >
          Haz clic aquí para descargar directo
        </a>
      </div>

      <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
        <a 
          href="/cv-rene-villegas.pdf" 
          download="Curriculum_Vitae_Rene_Villegas.pdf"
          class="px-3 py-1.5 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white font-medium transition-colors text-center"
        >
          Reintentar Descarga
        </a>
        <button 
          id="cli-close-footer-btn"
          class="px-3 py-1.5 rounded-lg bg-gray-800 hover:bg-gray-700 text-gray-300 transition-colors"
        >
          Cerrar
        </button>
      </div>
    </div>

  </div>
</div>

<!-- Modal Control Logic -->
<script>
  let modalOpen = false;
  let progressInterval: any = null;

  const modal = document.getElementById('cli-download-modal');
  const box = document.getElementById('cli-modal-box');
  const closeBtn = document.getElementById('cli-modal-close-btn');
  const closeCircle = document.getElementById('cli-close-circle');
  const closeFooterBtn = document.getElementById('cli-close-footer-btn');
  const progressBar = document.getElementById('cli-progress-bar');
  const progressPercent = document.getElementById('cli-progress-percent');
  const progressStatus = document.getElementById('cli-progress-status');
  const integrityMsg = document.getElementById('cli-integrity-msg');
  const completeMsg = document.getElementById('cli-complete-msg');

  function openCliModal() {
    if (!modal || !box) return;
    modalOpen = true;

    // Reset animations
    if (progressBar) progressBar.style.width = '0%';
    if (progressPercent) progressPercent.innerText = '0%';
    if (progressStatus) progressStatus.innerText = 'Iniciando transferencia HTTPS segura...';
    integrityMsg?.classList.add('hidden');
    completeMsg?.classList.add('hidden');

    // Show modal
    modal.classList.remove('opacity-0', 'pointer-events-none');
    box.classList.remove('scale-95');
    box.classList.add('scale-100');

    // Run simulated download progression
    let current = 0;
    if (progressInterval) clearInterval(progressInterval);

    progressInterval = setInterval(() => {
      current += Math.floor(Math.random() * 25) + 15;
      if (current >= 100) {
        current = 100;
        clearInterval(progressInterval);
        
        if (progressBar) progressBar.style.width = '100%';
        if (progressPercent) progressPercent.innerText = '100%';
        if (progressStatus) progressStatus.innerText = '584 KB recibidos — Verificación de firma completada';
        integrityMsg?.classList.remove('hidden');
        completeMsg?.classList.remove('hidden');

        // Automatically trigger actual download in browser
        triggerFileDownload();
      } else {
        if (progressBar) progressBar.style.width = `${current}%`;
        if (progressPercent) progressPercent.innerText = `${current}%`;
        if (progressStatus) progressStatus.innerText = `Descargando paquetes: ${Math.round((current * 584) / 100)} KB / 584 KB...`;
      }
    }, 120);
  }

  function closeCliModal() {
    if (!modal || !box) return;
    modalOpen = false;
    if (progressInterval) clearInterval(progressInterval);
    modal.classList.add('opacity-0', 'pointer-events-none');
    box.classList.remove('scale-100');
    box.classList.add('scale-95');
  }

  function triggerFileDownload() {
    const a = document.createElement('a');
    a.href = '/cv-rene-villegas.pdf';
    a.download = 'Curriculum_Vitae_Rene_Villegas.pdf';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }

  // Hook all elements with [data-open-cli-download]
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('[data-open-cli-download]');
    if (target) {
      e.preventDefault();
      openCliModal();
    }
  });

  // Close handlers
  closeBtn?.addEventListener('click', closeCliModal);
  closeCircle?.addEventListener('click', closeCliModal);
  closeFooterBtn?.addEventListener('click', closeCliModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeCliModal();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modalOpen) {
      closeCliModal();
    }
  });

  // Expose to window for inline calls if needed
  (window as any).openCliDownloadModal = openCliModal;
</script>
