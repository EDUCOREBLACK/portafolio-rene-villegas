---
<section class="min-h-[85vh] flex items-center max-w-5xl mx-auto px-6 py-12 md:py-16">
  <div class="grid lg:grid-cols-12 gap-8 items-start w-full">
    
    <!-- Profile Card (Left Column) -->
    <div class="lg:col-span-4 flex flex-col items-center sm:items-start bg-cloud-card p-6 rounded-2xl border border-cloud-border shadow-xl relative overflow-hidden group">
      <!-- Status Glow Header -->
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-cloud-azure via-cloud-green to-cloud-aws opacity-80"></div>
      
      <!-- Photo with Tech Badge Frame -->
      <div class="relative mb-5 mx-auto sm:mx-0">
        <div class="w-36 h-44 sm:w-40 sm:h-48 rounded-xl overflow-hidden border border-cloud-borderLight bg-cloud-bg shadow-md relative group">
          <img 
            src="/rene-villegas.jpg" 
            alt="René Villegas Carreño - Ingeniero TI" 
            class="w-full h-full object-cover object-center filter grayscale contrast-105 group-hover:grayscale-0 transition-all duration-300"
          />
          <div class="absolute bottom-1 right-1 px-1.5 py-0.5 rounded bg-black/80 text-[10px] font-mono text-cloud-azure border border-cloud-azure/40">
            N1/Senior
          </div>
        </div>
        <!-- Live Ping Indicator -->
        <div class="absolute -top-1.5 -right-1.5 flex items-center justify-center">
          <span class="animate-ping absolute inline-flex h-3.5 w-3.5 rounded-full bg-cloud-green opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-cloud-green"></span>
        </div>
      </div>

      <!-- Identity -->
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-cloud-text mb-1 text-center sm:text-left">
        René Villegas Carreño
      </h1>
      <p class="text-xs font-mono text-cloud-azure font-medium mb-3 text-center sm:text-left">
        Ing. TI & Continuidad Operacional
      </p>

      <!-- Cloud SLA Badges -->
      <div class="flex flex-wrap gap-1.5 mb-5 w-full justify-center sm:justify-start">
        <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cloud-bg text-cloud-green border border-cloud-border">
          ● SLA 99.999%
        </span>
        <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cloud-bg text-cloud-muted border border-cloud-border">
          ITIL & ISO 27001
        </span>
        <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cloud-bg text-cloud-azure border border-cloud-border">
          Python / IA Workflows
        </span>
      </div>

      <!-- Quick Contact Shortcuts -->
      <div class="w-full space-y-2 pt-4 border-t border-cloud-border text-xs font-mono">
        <a 
          href="https://wa.me/56965732414" 
          target="_blank" 
          rel="noopener noreferrer"
          class="flex items-center justify-between p-2 rounded-lg bg-cloud-bg hover:bg-cloud-cardHover border border-cloud-border text-cloud-muted hover:text-cloud-text transition-colors"
        >
          <span class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-cloud-green" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>+56 9 65732414</span>
          </span>
          <span class="text-cloud-green text-[10px]">Chat ↗</span>
        </a>

        <a 
          href="mailto:Duarapcsis@gmail.com"
          class="flex items-center justify-between p-2 rounded-lg bg-cloud-bg hover:bg-cloud-cardHover border border-cloud-border text-cloud-muted hover:text-cloud-text transition-colors"
        >
          <span class="flex items-center gap-2 truncate">
            <svg class="w-3.5 h-3.5 text-cloud-azure" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span class="truncate">Duarapcsis@gmail.com</span>
          </span>
          <span class="text-cloud-azure text-[10px]">Email ↗</span>
        </a>

        <div class="grid grid-cols-2 gap-2 pt-1">
          <a 
            href="https://www.linkedin.com/in/rene-eduardo-villegas-carreño-471a94140" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-1.5 p-2 rounded-lg bg-cloud-bg hover:bg-cloud-cardHover border border-cloud-border text-cloud-muted hover:text-cloud-text transition-colors text-center"
          >
            <svg class="w-3.5 h-3.5 text-cloud-azure" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            <span>LinkedIn</span>
          </a>

          <a 
            href="https://github.com/EDUCOREBLACK" 
            target="_blank" 
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-1.5 p-2 rounded-lg bg-cloud-bg hover:bg-cloud-cardHover border border-cloud-border text-cloud-muted hover:text-cloud-text transition-colors text-center"
          >
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </div>

    <!-- CLI Interactive Linux / VS Code Terminal (Right Column) -->
    <div class="lg:col-span-8 flex flex-col bg-cloud-card rounded-2xl border border-cloud-border shadow-2xl overflow-hidden font-mono text-xs">
      
      <!-- Terminal Window Bar (Traffic Dots & Tabs) -->
      <div class="h-10 bg-cloud-bg px-4 flex items-center justify-between border-b border-cloud-border select-none">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-cloud-red inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-cloud-yellow inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-cloud-green inline-block"></span>
          <span class="text-[11px] text-cloud-muted ml-2 font-mono hidden sm:inline-block">
            bash — rene@datacenter-core: ~ (ssh)
          </span>
        </div>
        <div class="flex items-center gap-3 text-[10px] text-cloud-muted">
          <span class="hidden md:inline-block">UTF-8</span>
          <span class="flex items-center gap-1 text-cloud-green">
            <span class="w-1.5 h-1.5 rounded-full bg-cloud-green animate-pulse"></span>
            ACTIVE 24/7
          </span>
        </div>
      </div>

      <!-- Quick Command Bar / Interactive Presets -->
      <div class="bg-cloud-card px-4 py-2 border-b border-cloud-border/70 flex flex-wrap items-center gap-2 text-[11px]">
        <span class="text-cloud-muted text-[10px]">Comandos rápidos:</span>
        <button id="cmd-whoami" class="px-2.5 py-1 rounded bg-cloud-bg hover:border-cloud-azure border border-cloud-border text-cloud-azure transition-colors">
          $ whoami
        </button>
        <button id="cmd-about" class="px-2.5 py-1 rounded bg-cloud-bg hover:border-cloud-azure border border-cloud-border text-cloud-text transition-colors">
          $ cat about_me.txt
        </button>
        <button id="cmd-cv" class="px-2.5 py-1 rounded bg-cloud-bg hover:border-cloud-green border border-cloud-border text-cloud-green transition-colors font-semibold">
          $ ./download_cv.sh
        </button>
        <button id="cmd-contact" class="px-2.5 py-1 rounded bg-cloud-bg hover:border-cloud-azure border border-cloud-border text-cloud-muted hover:text-cloud-text transition-colors">
          $ cat contact.env
        </button>
        <button id="cmd-clear" class="px-2 py-1 rounded bg-cloud-bg hover:border-cloud-borderLight border border-cloud-border text-cloud-muted transition-colors ml-auto">
          clear
        </button>
      </div>

      <!-- Terminal Output Screen -->
      <div id="cli-screen" class="p-5 min-h-[380px] max-h-[500px] overflow-y-auto space-y-3 leading-relaxed text-cloud-text bg-cloud-bg/95">
        <!-- Lines injected via JS -->
      </div>

      <!-- Command Prompt Input Line -->
      <div class="p-3 bg-cloud-card border-t border-cloud-border flex items-center gap-2">
        <span class="text-cloud-green font-bold">rene@datacenter:~$</span>
        <input 
          type="text" 
          id="cli-input" 
          placeholder="Escribe 'help', 'cv', 'about' o presiona los botones arriba..."
          class="flex-1 bg-transparent text-cloud-text focus:outline-none font-mono text-xs placeholder:text-cloud-muted/60"
        />
        <button id="cli-enter-btn" class="px-2.5 py-1 rounded bg-cloud-bg hover:border-cloud-azure border border-cloud-border text-[10px] text-cloud-azure">
          ↵ Enter
        </button>
      </div>

    </div>

  </div>
</section>

<!-- Terminal Logic Script -->
<script>
  const screen = document.getElementById('cli-screen');
  const input = document.getElementById('cli-input') as HTMLInputElement;
  const enterBtn = document.getElementById('cli-enter-btn');

  function appendLine(content: string, type: 'cmd' | 'output' | 'success' | 'warn' | 'azure' = 'output') {
    if (!screen) return;
    const div = document.createElement('div');
    div.className = 'leading-relaxed break-words';
    
    if (type === 'cmd') {
      div.innerHTML = `<span class="text-cloud-green font-bold">rene@datacenter:~$</span> <span class="text-cloud-text font-semibold">${content}</span>`;
    } else if (type === 'success') {
      div.innerHTML = `<span class="text-cloud-green">${content}</span>`;
    } else if (type === 'warn') {
      div.innerHTML = `<span class="text-cloud-yellow">${content}</span>`;
    } else if (type === 'azure') {
      div.innerHTML = `<span class="text-cloud-azure">${content}</span>`;
    } else {
      div.innerHTML = `<span class="text-cloud-muted">${content}</span>`;
    }
    screen.appendChild(div);
    screen.scrollTop = screen.scrollHeight;
  }

  function runCommand(rawCmd: string) {
    const cmd = rawCmd.trim().toLowerCase();
    appendLine(rawCmd, 'cmd');

    if (cmd === 'whoami' || cmd === '1') {
      appendLine("👤 NOMBRE: René Eduardo Villegas Carreño", 'azure');
      appendLine("💼 ROL: Ingeniero en Tecnologías de la Información & Telecomunicaciones", 'output');
      appendLine("📍 UBICACIÓN: Santiago, Chile | Disponibilidad Operacional 24/7", 'output');
    } else if (cmd === 'cat about_me.txt' || cmd === 'about') {
      appendLine("=== RESUMEN EJECUTIVO ===", 'azure');
      appendLine("• Con más de 15 años liderando operaciones de misión crítica 24/7 en Centros de Datos de gran escala.", 'output');
      appendLine("• Especialista en continuidad operacional, gobernanza bajo marco ITIL y normativas ISO 27001.", 'output');
      appendLine("• Diseño y ejecución de planes de recuperación ante desastres (DRP) con resguardo de SLA 99.999%.", 'output');
      appendLine("• Automatización técnica y flujos analíticos con Python, SQL, Linux y herramientas de Inteligencia Artificial.", 'output');
    } else if (cmd === './download_cv.sh' || cmd === 'download cv' || cmd === 'cv') {
      appendLine("[*] Inicializando descarga segura de Currículum Vitae...", 'azure');
      appendLine("Connecting to https://renevillegas.dev/cv-rene-villegas.pdf ... 200 OK", 'output');
      appendLine("Length: 584,141 bytes (584 KB) [application/pdf]", 'output');
      appendLine("[==================================================>] 100% 584KB in 0.08s", 'success');
      appendLine(`✔ Descarga iniciada con éxito. <a href="/cv-rene-villegas.pdf" download="Curriculum_Vitae_Rene_Villegas.pdf" class="underline text-cloud-azure font-bold ml-1">Clic aquí si no descargó automáticamente</a>`, 'success');
      
      // Trigger download
      const a = document.createElement('a');
      a.href = '/cv-rene-villegas.pdf';
      a.download = 'Curriculum_Vitae_Rene_Villegas.pdf';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    } else if (cmd === 'cat contact.env' || cmd === 'contact') {
      appendLine("=== CANALES DE CONTACTO DIRECTO ===", 'azure');
      appendLine("PHONE_WHATSAPP=+56 9 65732414", 'success');
      appendLine("EMAIL=Duarapcsis@gmail.com", 'success');
      appendLine("LINKEDIN=https://www.linkedin.com/in/rene-eduardo-villegas-carreño-471a94140", 'output');
      appendLine("GITHUB=https://github.com/EDUCOREBLACK", 'output');
    } else if (cmd === 'clear' || cmd === 'cls') {
      if (screen) screen.innerHTML = '';
      return;
    } else if (cmd === 'help') {
      appendLine("Comandos disponibles en este terminal:", 'azure');
      appendLine("  whoami               Muestra identidad y especialidad principal", 'output');
      appendLine("  cat about_me.txt     Despliega trayectoria y competencias", 'output');
      appendLine("  ./download_cv.sh     Simula consola y descarga el CV en PDF oficial", 'output');
      appendLine("  cat contact.env      Muestra datos de contacto y redes", 'output');
      appendLine("  clear                Limpia la pantalla de la terminal", 'output');
    } else if (cmd === '') {
      // do nothing
    } else {
      appendLine(`bash: ${rawCmd}: comando no encontrado. Escribe 'help' para ver opciones.`, 'warn');
    }
  }

  // Interactive Button Listeners
  document.getElementById('cmd-whoami')?.addEventListener('click', () => runCommand('whoami'));
  document.getElementById('cmd-about')?.addEventListener('click', () => runCommand('cat about_me.txt'));
  document.getElementById('cmd-cv')?.addEventListener('click', () => runCommand('./download_cv.sh'));
  document.getElementById('cmd-contact')?.addEventListener('click', () => runCommand('cat contact.env'));
  document.getElementById('cmd-clear')?.addEventListener('click', () => runCommand('clear'));

  // Input listener
  function handleInput() {
    if (!input) return;
    const value = input.value;
    if (value.trim()) {
      runCommand(value);
      input.value = '';
    }
  }

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      handleInput();
    }
  });

  enterBtn?.addEventListener('click', handleInput);

  // Initial Boot Sequence (Simulated realistic typing)
  setTimeout(() => {
    appendLine("Initializing Linux Data Center Node (Kernel 6.1.0-cloud) ...", 'output');
    appendLine("Connection established to core-infrastructure [SLA 99.999%]", 'success');
    setTimeout(() => {
      runCommand('whoami');
      setTimeout(() => {
        runCommand('cat about_me.txt');
      }, 700);
    }, 500);
  }, 200);
</script>
