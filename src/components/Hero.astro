---
---
<section class="min-h-[75vh] flex items-center max-w-5xl mx-auto px-6 py-16 md:py-24">
  <div class="grid md:grid-cols-12 gap-10 md:gap-14 items-center w-full">
    
    <!-- Text Column -->
    <div class="md:col-span-8 flex flex-col items-start order-2 md:order-1">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-card border border-brand-border text-xs font-mono text-brand-muted mb-6">
        <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span>
        Operaciones Críticas & Automatización TI
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-brand-text mb-4">
        René Villegas Carreño
      </h1>

      <p class="text-lg sm:text-xl text-brand-muted font-normal mb-6 leading-relaxed">
        Ingeniero en Tecnologías de la Información con más de 15 años liderando operaciones de misión crítica 24/7, continuidad operacional y automatización en centros de datos de alta disponibilidad.
      </p>

      <p class="text-sm sm:text-base text-brand-muted/90 max-w-2xl mb-8 leading-relaxed">
        Especialista en gobernanza técnica y gestión de servicios bajo marco <strong class="text-brand-text font-medium">ITIL</strong>, normas <strong class="text-brand-text font-medium">ISO 27001</strong> y planes de continuidad <strong class="text-brand-text font-medium">DRP</strong>. Desarrollo de flujos analíticos y optimización operativa mediante <strong class="text-brand-text font-medium">Python, SQL, Linux y herramientas de IA</strong>.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
        <a 
          href="/cv-rene-villegas.pdf" 
          download="Curriculum_Vitae_Rene_Villegas.pdf"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-brand-text text-brand-bg font-medium text-sm hover:bg-white/90 transition-all duration-200 shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          Descargar Currículum (PDF)
        </a>

        <a 
          href="#github" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg border border-brand-border bg-brand-card hover:bg-brand-cardHover hover:border-brand-borderHover text-brand-text font-medium text-sm transition-all duration-200"
        >
          <svg class="w-4 h-4 text-brand-muted" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          Portafolio GitHub
        </a>
      </div>
    </div>

    <!-- Photo Column -->
    <div class="md:col-span-4 flex justify-center order-1 md:order-2">
      <div class="relative group">
        <!-- Subtle back glow -->
        <div class="absolute -inset-1 bg-gradient-to-r from-brand-border to-brand-borderHover rounded-2xl blur-sm opacity-50 group-hover:opacity-75 transition duration-500"></div>
        
        <div class="relative w-52 h-64 sm:w-60 sm:h-72 rounded-2xl overflow-hidden border border-brand-border bg-brand-card shadow-2xl">
          <img 
            src="/rene-villegas.jpg" 
            alt="René Villegas Carreño - Ingeniero TI" 
            class="w-full h-full object-cover object-center filter grayscale contrast-105 group-hover:grayscale-0 transition-all duration-500"
          />
        </div>
      </div>
    </div>

  </div>
</section>
