---
const repos = [
  {
    name: "portafolio-rene-villegas",
    description: "Portal profesional de alto rendimiento y arquitectura minimalista desarrollado con Astro, Tailwind CSS y Markdown. Formato Cruip Open PRO y CI/CD desplegado en Vercel.",
    language: "Astro",
    languageColor: "#ff5d01",
    url: "https://github.com/EDUCOREBLACK/portafolio-rene-villegas"
  },
  {
    name: "inventario-bodega",
    description: "Sistema de control y conciliación de inventario para bodega y parque computacional tecnológico de alta escala.",
    language: "JavaScript",
    languageColor: "#f1e05a",
    url: "https://github.com/EDUCOREBLACK/inventario-bodega"
  },
  {
    name: "fashion_glam_stylee",
    description: "Desarrollo de módulos funcionales y flujos analíticos de datos procesados en lenguaje Python.",
    language: "Python",
    languageColor: "#3572A5",
    url: "https://github.com/EDUCOREBLACK/fashion_glam_stylee"
  },
  {
    name: "cafeteria",
    description: "API REST y arquitectura de microservicios para sistema de atención, facturación y gestión operativa de pedidos.",
    language: "TypeScript",
    languageColor: "#3178c6",
    url: "https://github.com/EDUCOREBLACK/cafeteria-donde-lucy"
  }
];
---

<section id="portafolio" class="max-w-5xl mx-auto px-6 py-16 border-t border-gray-800/80">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
    <div>
      <div class="pro-badge mb-2">
        <span class="bg-gradient-to-r from-indigo-400 to-indigo-200 bg-clip-text text-transparent text-xs font-mono font-semibold tracking-wider uppercase">
          Código Abierto & Proyectos
        </span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-bold text-gradient-pro">
        Portafolio en GitHub
      </h2>
    </div>
    
    <a 
      href="https://github.com/EDUCOREBLACK" 
      target="_blank" 
      rel="noopener noreferrer"
      class="btn-pro-secondary inline-flex items-center gap-2 text-xs font-mono px-4 py-2 rounded-xl self-start md:self-auto group"
    >
      <svg class="w-4 h-4 text-gray-400 group-hover:text-indigo-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
      </svg>
      <span>@EDUCOREBLACK</span>
      <span class="text-indigo-400 group-hover:translate-x-0.5 transition-transform">↗</span>
    </a>
  </div>

  <div class="grid md:grid-cols-2 gap-5">
    {repos.map((repo) => (
      <a 
        href={repo.url} 
        target="_blank" 
        rel="noopener noreferrer"
        class="pro-card p-6 rounded-2xl border border-gray-800/80 hover:border-indigo-500/50 flex flex-col justify-between group transition-all"
      >
        <div>
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm sm:text-base font-bold text-gray-100 group-hover:text-indigo-400 transition-colors flex items-center gap-1.5 font-mono">
              <span>{repo.name}</span>
              <svg class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </h3>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-gray-900 text-gray-400 border border-gray-800">
              Público
            </span>
          </div>
          <p class="text-xs text-gray-400 leading-relaxed mb-6">
            {repo.description}
          </p>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-gray-800/80 text-xs font-mono text-gray-400">
          <span class="inline-flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${repo.languageColor}`}></span>
            <span class="text-gray-300">{repo.language}</span>
          </span>
          <span class="text-indigo-400 group-hover:translate-x-1 transition-transform flex items-center gap-1 font-semibold">
            Ver código ↗
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
