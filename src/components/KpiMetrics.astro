---
const kpis = [
  {
    id: "sla",
    metric: "99.999% SLA",
    subtitle: "Cero Caídas Troncales",
    detail: "Resguardo ininterrumpido de plataformas de cómputo, sistemas de respaldo de energía (UPS) y enlaces corporativos redundantes.",
    badge: "Alta Disponibilidad",
    badgeColor: "text-emerald-400 bg-emerald-950/60 border-emerald-800/60 dark:text-emerald-400 dark:bg-emerald-950/60 dark:border-emerald-800/60 text-emerald-700 bg-emerald-50 border-emerald-200",
    barPercent: "100%",
    barColor: "from-emerald-500 to-cyan-400",
    telemetry: "DOWNTIME ANUAL: 0.00 seg",
    icon: "shield"
  },
  {
    id: "mttr",
    metric: "-40% MTTR",
    subtitle: "< 15 min de Respuesta",
    detail: "Reducción del tiempo medio de atención y resolución en fallas críticas mediante estandarización rigurosa de procedimientos (SOPs).",
    badge: "Eficiencia N1/Senior",
    badgeColor: "text-cyan-400 bg-cyan-950/60 border-cyan-800/60 dark:text-cyan-400 dark:bg-cyan-950/60 dark:border-cyan-800/60 text-cyan-700 bg-cyan-50 border-cyan-200",
    barPercent: "85%",
    barColor: "from-cyan-500 to-blue-500",
    telemetry: "ANTES: 25 min ➔ AHORA: < 15 min",
    icon: "clock"
  },
  {
    id: "rfc",
    metric: "99.4% Éxito",
    subtitle: "100+ Ventanas Nocturnas",
    detail: "Cableados de fibra/cobre, migraciones de racks y puestas en marcha ejecutadas sin rollbacks ni afectación de servicios a clientes.",
    badge: "Gestión de Cambios",
    badgeColor: "text-blue-400 bg-blue-950/60 border-blue-800/60 dark:text-blue-400 dark:bg-blue-950/60 dark:border-blue-800/60 text-blue-700 bg-blue-50 border-blue-200",
    barPercent: "99.4%",
    barColor: "from-blue-500 to-indigo-500",
    telemetry: "0 ROLLBACKS EN VENTANAS CRÍTICAS",
    icon: "check"
  },
  {
    id: "ops",
    metric: "24/7 Ops",
    subtitle: "Supervisión de Turnos",
    detail: "Coordinación técnica de personal en terreno, control de bitácoras, traspasos de turno estructurados y auditoría de inventario de activos.",
    badge: "Liderazgo de Cuadrilla",
    badgeColor: "text-violet-400 bg-violet-950/60 border-violet-800/60 dark:text-violet-400 dark:bg-violet-950/60 dark:border-violet-800/60 text-violet-700 bg-violet-50 border-violet-200",
    barPercent: "100%",
    barColor: "from-violet-500 to-cyan-400",
    telemetry: "ROTACIÓN CONTINUA 365 DÍAS",
    icon: "activity"
  }
];

const protocols = [
  {
    number: "01",
    name: "Análisis Causa Raíz (RCA)",
    tag: "Post-Incidente",
    desc: "Investigación exhaustiva posterior a cualquier desviación para erradicar fallas recurrentes en hardware, módulos SFP y cableado de enlace.",
    metric: "100% Incidentes Documentados"
  },
  {
    number: "02",
    name: "Auditoría Preventiva de Racks",
    tag: "Control Físico & Térmico",
    desc: "Termografía periódica, balanceo de fases en PDUs y peinado ordenado de canalizaciones para prevenir sobrecalentamiento y estrés mecánico en fibra óptica.",
    metric: "Cero Hot-Spots en Racks"
  },
  {
    number: "03",
    name: "Traspaso Estructurado de Turno",
    tag: "Continuidad 24/7",
    desc: "Protocolos de relevo rigurosos mediante listas de verificación estándar que garantizan que ninguna alerta, ticket o pendiente quede sin seguimiento.",
    metric: "100% Trazabilidad Operativa"
  }
];
---

<section id="telemetria" class="max-w-5xl mx-auto px-6 py-16 border-t border-slate-800/80 dark:border-slate-800/80 border-slate-200 transition-colors">
  
  <!-- Header / Badge -->
  <div class="mb-12 text-center sm:text-left">
    <div class="pro-badge mb-2">
      <span class="inline-flex items-center gap-2 bg-gradient-to-r from-cyan-400 to-emerald-400 dark:from-cyan-400 dark:to-emerald-400 from-blue-600 to-cyan-600 bg-clip-text text-transparent text-xs font-mono font-bold tracking-wider uppercase">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        ● TELEMETRÍA OPERACIONAL & RESULTADOS MEDIBLES
      </span>
    </div>
    
    <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight text-gradient-pro mb-3">
      Gestión de Continuidad & Eficiencia Operativa en Data Centers
    </h2>
    
    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed">
      Impacto cuantitativo liderando infraestructura de misión crítica, supervisión de cuadrillas 24/7 y mitigación sistemática de quiebres de servicio bajo marcos ITIL e ISO 27001.
    </p>
  </div>

  <!-- 4 KPI Metrics Grid -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
    {kpis.map((kpi) => (
      <div class="noc-kpi-card p-6 flex flex-col justify-between group cursor-default">
        <div>
          <!-- Header Bar with badge and live icon -->
          <div class="flex items-center justify-between mb-4">
            <span class={`text-[10px] font-mono px-2 py-0.5 rounded-full border ${kpi.badgeColor}`}>
              {kpi.badge}
            </span>
            <div class="w-2 h-2 rounded-full bg-emerald-400 group-hover:scale-125 transition-transform duration-300"></div>
          </div>

          <!-- Big Metric Number -->
          <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight mb-1 group-hover:text-cyan-500 dark:group-hover:text-cyan-400 transition-colors font-mono">
            {kpi.metric}
          </div>

          <!-- Subtitle -->
          <div class="text-xs font-bold text-cyan-600 dark:text-cyan-300 mb-2">
            {kpi.subtitle}
          </div>

          <!-- Detail paragraph -->
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            {kpi.detail}
          </p>
        </div>

        <!-- Telemetry bar & micro-metric footer -->
        <div class="pt-3 border-t border-slate-200 dark:border-slate-800">
          <div class="flex items-center justify-between text-[10px] font-mono text-slate-500 dark:text-slate-400 mb-1.5">
            <span class="truncate">{kpi.telemetry}</span>
            <span class="text-emerald-500 dark:text-emerald-400 font-bold">{kpi.barPercent}</span>
          </div>
          <div class="w-full bg-slate-200 dark:bg-slate-800 rounded-full h-1.5 overflow-hidden">
            <div 
              class={`bg-gradient-to-r ${kpi.barColor} h-1.5 rounded-full transition-all duration-700 group-hover:opacity-100 opacity-90`}
              style={`width: ${kpi.barPercent}`}
            ></div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Methodology Console Panel (Detección y Mitigación de Quiebres) -->
  <div class="noc-kpi-card p-6 sm:p-8 border border-slate-800/80 bg-slate-900/90 dark:bg-slate-900/90 bg-white">
    
    <!-- Console Title Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-200 dark:border-slate-800 mb-6">
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1.5">
          <span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-500 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span>
        </div>
        <span class="text-xs font-mono font-bold text-slate-900 dark:text-slate-200">
          NOC-SOP-CONSOLE // PROTOCOLOS DE DETECCIÓN & MITIGACIÓN DE QUIEBRES
        </span>
      </div>

      <div class="flex items-center gap-2 text-[11px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-2.5 py-1 rounded-lg border border-emerald-200 dark:border-emerald-800/50 self-start sm:self-auto">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>AUDITORÍA ACTIVA ITIL v4 / ISO 27001</span>
      </div>
    </div>

    <!-- 3 Protocol Columns -->
    <div class="grid md:grid-cols-3 gap-6">
      {protocols.map((proto) => (
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 hover:border-cyan-500/50 transition-all group">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono font-bold text-cyan-600 dark:text-cyan-400 bg-cyan-100 dark:bg-cyan-950/80 px-2 py-0.5 rounded border border-cyan-200 dark:border-cyan-800/60">
              PASO {proto.number}
            </span>
            <span class="text-[10px] font-mono text-slate-500 dark:text-slate-400">
              {proto.tag}
            </span>
          </div>

          <h4 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors mb-2">
            {proto.name}
          </h4>

          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            {proto.desc}
          </p>

          <div class="pt-2.5 border-t border-slate-200 dark:border-slate-800 text-[11px] font-mono text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1.5">
            <span>✔</span>
            <span>{proto.metric}</span>
          </div>
        </div>
      ))}
    </div>

  </div>

</section>
