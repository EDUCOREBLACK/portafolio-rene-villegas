---
const dcBreakdown = [
  { name: "Data Center Alpha (Principal)", racks: 420, capacity: 72, temp: "19.5°C", pduLoad: "68%" },
  { name: "Data Center Beta (Corporativo)", racks: 360, capacity: 69, temp: "20.1°C", pduLoad: "71%" },
  { name: "Data Center Gamma (Misión Crítica)", racks: 200, capacity: 70, temp: "19.2°C", pduLoad: "67%" },
];

const ticketCategories = [
  { name: "Hardware & Servidores", percent: 40, color: "#ffffff" },
  { name: "Red, Fibra & Conectividad", percent: 25, color: "#cbd5e1" },
  { name: "Climatización & PDU", percent: 20, color: "#94a3b8" },
  { name: "Sistemas & Solicitudes RFC", percent: 15, color: "#64748b" }
];
---

<section id="telemetria" class="max-w-5xl mx-auto px-6 py-16 border-t border-zinc-200 dark:border-white/10 transition-colors reveal">
  
  <!-- Header del Dashboard (Kitu Minimalist Style) -->
  <div class="mb-10">
    <div class="inline-flex items-center gap-2 mb-2 font-mono text-xs uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400 font-semibold">
      <span class="w-2 h-2 rounded-full bg-zinc-900 dark:bg-white animate-pulse"></span>
      <span>Dashboard de Control & Telemetría Operacional</span>
    </div>
    
    <h2 class="text-2xl sm:text-4xl font-heading font-bold text-zinc-950 dark:text-white tracking-tight mb-3">
      Logros Operacionales & Métricas de Eficiencia
    </h2>
    
    <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-3xl leading-relaxed">
      Indicadores cuantitativos de gestión de incidencias, reducción drástica de tiempos de atención, optimización de clasificación de tickets y continuidad en Data Centers 24/7.
    </p>
  </div>

  <!-- Historia del Caso de Éxito: Transformación Operacional -->
  <div class="mb-12 p-6 sm:p-8 rounded-2xl border border-zinc-200 dark:border-white/10 bg-white dark:bg-[#0f1118] shadow-sm relative overflow-hidden reveal reveal-delay-1">
    <div class="absolute top-0 left-0 w-1.5 h-full bg-zinc-900 dark:bg-white"></div>
    
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-100 dark:bg-white/5 text-zinc-900 dark:text-white font-mono text-xs font-semibold mb-3 border border-zinc-300 dark:border-white/10 uppercase tracking-wider">
          <span>★</span> Caso de Éxito: Estandarización & Reducción de Tiempos
        </div>
        
        <h3 class="text-lg sm:text-xl font-heading font-bold text-zinc-950 dark:text-white mb-3">
          ¿Cómo logramos transformar la respuesta operativa ante contingencias?
        </h3>
        
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
          Al asumir la supervisión técnica en salas de misión crítica, los tiempos iniciales de atención oscilaban entre los <strong>25 y 30 minutos</strong>, existía fricción en la tipificación de tickets y la información de activos se encontraba dispersa.
        </p>

        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
          Implementamos una <strong>cultura de respuesta proactiva con SOPs rigurosos</strong>: apertura inmediata del ticket ante la primera alarma, escalamiento automatizado vía <span class="text-zinc-900 dark:text-white font-semibold font-mono">Power Automate</span>, centralización en <span class="text-zinc-900 dark:text-white font-semibold font-mono">NetBox DCIM</span> y el hábito en la cuadrilla de <strong>reportar avances con estado al cliente dentro de los primeros 10 minutos</strong>.
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-zinc-100 dark:border-white/10 font-mono text-xs">
          <div>
            <span class="text-zinc-500 dark:text-zinc-400 block text-[10px] uppercase">Primera Respuesta</span>
            <span class="text-zinc-950 dark:text-white font-bold text-sm sm:text-base">&lt; 10 min (-65%)</span>
          </div>
          <div>
            <span class="text-zinc-500 dark:text-zinc-400 block text-[10px] uppercase">MTTR Resolución</span>
            <span class="text-zinc-950 dark:text-white font-bold text-sm sm:text-base">&lt; 15 min (-40%)</span>
          </div>
          <div>
            <span class="text-zinc-500 dark:text-zinc-400 block text-[10px] uppercase">Tickets Recurrentes</span>
            <span class="text-zinc-950 dark:text-white font-bold text-sm sm:text-base">-35% Mitigados</span>
          </div>
          <div>
            <span class="text-zinc-500 dark:text-zinc-400 block text-[10px] uppercase">Clasificación Efectiva</span>
            <span class="text-zinc-950 dark:text-white font-bold text-sm sm:text-base">96% 1er Contacto</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Gráficos de Torta (Donut) & Bloques de Avance -->
  <div class="grid lg:grid-cols-12 gap-6 mb-12">
    
    <!-- Gráfico Donut 1: Clasificación & Tipificación de Tickets -->
    <div class="lg:col-span-6 p-6 rounded-2xl border border-zinc-200 dark:border-white/10 bg-white dark:bg-[#0f1118] shadow-sm flex flex-col justify-between reveal">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h4 class="text-sm font-bold text-zinc-950 dark:text-white flex items-center gap-2">
              <span>🎯</span> Clasificación de Tickets por Especialidad
            </h4>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">
              Precisión de enrutamiento inmediato al especialista adecuado
            </p>
          </div>
          <span class="text-xs font-mono font-bold text-zinc-950 dark:text-white px-2.5 py-0.5 rounded-full bg-zinc-100 dark:bg-white/10 border border-zinc-300 dark:border-white/15">
            96% Efectividad
          </span>
        </div>

        <!-- Donut SVG + Leyenda -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 my-4">
          
          <div class="relative w-36 h-36 flex-shrink-0 flex items-center justify-center">
            <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="currentColor" stroke-width="12" class="text-zinc-200 dark:text-zinc-800"></circle>
              <!-- Segmento 1: Hardware 40% -->
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="#ffffff" stroke-width="12" stroke-dasharray="95.5 238.7" stroke-dashoffset="0" class="dark:stroke-white stroke-zinc-950"></circle>
              <!-- Segmento 2: Red & Fibra 25% -->
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="#cbd5e1" stroke-width="12" stroke-dasharray="59.7 238.7" stroke-dashoffset="-95.5" class="dark:stroke-zinc-400 stroke-zinc-700"></circle>
              <!-- Segmento 3: Clima & PDU 20% -->
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="#94a3b8" stroke-width="12" stroke-dasharray="47.7 238.7" stroke-dashoffset="-155.2" class="dark:stroke-zinc-600 stroke-zinc-500"></circle>
              <!-- Segmento 4: Sistemas 15% -->
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="#64748b" stroke-width="12" stroke-dasharray="35.8 238.7" stroke-dashoffset="-202.9" class="dark:stroke-zinc-700 stroke-zinc-400"></circle>
            </svg>
            
            <div class="absolute flex flex-col items-center justify-center text-center">
              <span class="text-xl font-mono font-bold text-zinc-950 dark:text-white">96%</span>
              <span class="text-[9px] font-mono text-zinc-500 uppercase tracking-wider">Precisión</span>
            </div>
          </div>

          <div class="space-y-2 text-xs font-mono w-full">
            {ticketCategories.map((cat) => (
              <div class="flex items-center justify-between text-zinc-700 dark:text-zinc-300">
                <span class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-zinc-900 dark:bg-white border border-zinc-400 dark:border-white/20"></span>
                  <span class="text-[11px] truncate max-w-[170px]">{cat.name}</span>
                </span>
                <span class="font-bold text-zinc-950 dark:text-white text-xs">{cat.percent}%</span>
              </div>
            ))}
          </div>

        </div>
      </div>

      <p class="text-[11px] text-zinc-500 dark:text-zinc-400 pt-3 border-t border-zinc-100 dark:border-white/10">
        ✔ <strong>Cero rebotes entre cuadrillas:</strong> Tipificación estandarizada desde el ingreso del ticket, permitiendo derivación directa a sala o soporte especializado.
      </p>
    </div>

    <!-- Gráfico Donut 2: Reducción de Incidentes & Mitigación Causa Raíz -->
    <div class="lg:col-span-6 p-6 rounded-2xl border border-zinc-200 dark:border-white/10 bg-white dark:bg-[#0f1118] shadow-sm flex flex-col justify-between reveal reveal-delay-1">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h4 class="text-sm font-bold text-zinc-950 dark:text-white flex items-center gap-2">
              <span>📉</span> Reducción de Quiebres & Tickets Recurrentes
            </h4>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">
              Análisis Causa Raíz (RCA) y eliminación de incidentes repetitivos
            </p>
          </div>
          <span class="text-xs font-mono font-bold text-zinc-950 dark:text-white px-2.5 py-0.5 rounded-full bg-zinc-100 dark:bg-white/10 border border-zinc-300 dark:border-white/15">
            -35% Tickets
          </span>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 my-4">
          
          <div class="relative w-36 h-36 flex-shrink-0 flex items-center justify-center">
            <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="currentColor" stroke-width="12" class="text-zinc-200 dark:text-zinc-800"></circle>
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="#ffffff" stroke-width="12" stroke-dasharray="155.1 238.7" stroke-dashoffset="0" class="dark:stroke-white stroke-zinc-950"></circle>
              <circle cx="50" cy="50" r="38" fill="transparent" stroke="#94a3b8" stroke-width="12" stroke-dasharray="83.5 238.7" stroke-dashoffset="-155.1" class="dark:stroke-zinc-600 stroke-zinc-400"></circle>
            </svg>
            
            <div class="absolute flex flex-col items-center justify-center text-center">
              <span class="text-xl font-mono font-bold text-zinc-950 dark:text-white">-35%</span>
              <span class="text-[9px] font-mono text-zinc-500 uppercase tracking-wider">Recurrentes</span>
            </div>
          </div>

          <div class="space-y-3 text-xs font-mono w-full">
            <div class="p-2.5 rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-50 dark:bg-white/5">
              <span class="text-zinc-500 text-[10px] block uppercase">Acción Preventiva (RCA)</span>
              <span class="text-zinc-950 dark:text-white font-bold text-xs">Procedimientos SOPs en Sala</span>
            </div>
            <div class="p-2.5 rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-50 dark:bg-white/5">
              <span class="text-zinc-500 text-[10px] block uppercase">Mitigación de Falsas Alarmas</span>
              <span class="text-zinc-950 dark:text-white font-bold text-xs">Filtro Inteligente Power Automate</span>
            </div>
          </div>

        </div>
      </div>

      <p class="text-[11px] text-zinc-500 dark:text-zinc-400 pt-3 border-t border-zinc-100 dark:border-white/10">
        ✔ <strong>Resolución de Fondo:</strong> Cada incidente mayor derivó en una actualización del manual de contingencia para que ninguna falla se repitiera en los turnos siguientes.
      </p>
    </div>

  </div>

  <!-- Bloques de Avance y Comparativa Antes vs Ahora -->
  <div class="p-6 sm:p-8 rounded-2xl border border-zinc-200 dark:border-white/10 bg-white dark:bg-[#0f1118] shadow-sm mb-12 reveal">
    <div class="flex items-center gap-2 mb-6">
      <span class="text-sm font-mono text-zinc-900 dark:text-white">⚡</span>
      <h3 class="text-xs font-mono uppercase tracking-[0.15em] text-zinc-800 dark:text-zinc-200 font-bold">
        Bloques de Avance & Rendimiento Operacional
      </h3>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      
      <!-- Bloque 1: Tiempo de Primera Respuesta -->
      <div class="space-y-2 p-4 rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-50/70 dark:bg-white/5 font-mono text-xs">
        <div class="flex justify-between items-center text-zinc-800 dark:text-zinc-200 font-bold">
          <span>Tiempo de Primera Respuesta (Ticket / Alerta)</span>
          <span class="text-zinc-950 dark:text-white">-65% Tiempo</span>
        </div>
        
        <div class="flex justify-between text-[11px] text-zinc-500 mb-1">
          <span>Sin Estandarización: 25 - 30 min</span>
          <span class="text-zinc-500">Lento</span>
        </div>
        <div class="w-full bg-zinc-200 dark:bg-zinc-800 rounded-full h-2">
          <div class="bg-zinc-400 dark:bg-zinc-600 h-2 rounded-full w-[85%]"></div>
        </div>

        <div class="flex justify-between text-[11px] text-zinc-900 dark:text-white font-bold pt-1">
          <span>Con SOPs & Hábitos de Respuesta: &lt; 10 min</span>
          <span>Logrado ✔</span>
        </div>
        <div class="w-full bg-zinc-200 dark:bg-zinc-800 rounded-full h-2">
          <div class="bg-zinc-950 dark:bg-white h-2 rounded-full w-[30%]"></div>
        </div>
      </div>

      <!-- Bloque 2: MTTR Resolución en Fallas Críticas -->
      <div class="space-y-2 p-4 rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-50/70 dark:bg-white/5 font-mono text-xs">
        <div class="flex justify-between items-center text-zinc-800 dark:text-zinc-200 font-bold">
          <span>MTTR (Tiempo Medio de Resolución de Incidentes)</span>
          <span class="text-zinc-950 dark:text-white">-40% MTTR</span>
        </div>
        
        <div class="flex justify-between text-[11px] text-zinc-500 mb-1">
          <span>Tiempo Anterior: 25 min</span>
          <span class="text-zinc-500">Elevado</span>
        </div>
        <div class="w-full bg-zinc-200 dark:bg-zinc-800 rounded-full h-2">
          <div class="bg-zinc-400 dark:bg-zinc-600 h-2 rounded-full w-[80%]"></div>
        </div>

        <div class="flex justify-between text-[11px] text-zinc-900 dark:text-white font-bold pt-1">
          <span>Tiempo Optimizado con DRP: &lt; 15 min</span>
          <span>Logrado ✔</span>
        </div>
        <div class="w-full bg-zinc-200 dark:bg-zinc-800 rounded-full h-2">
          <div class="bg-zinc-950 dark:bg-white h-2 rounded-full w-[45%]"></div>
        </div>
      </div>

      <!-- Bloque 3: Éxito en Ventanas Nocturnas de Cambio (RFCs) -->
      <div class="space-y-2 p-4 rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-50/70 dark:bg-white/5 font-mono text-xs">
        <div class="flex justify-between items-center text-zinc-800 dark:text-zinc-200 font-bold">
          <span>Éxito en Solicitudes de Cambio (RFCs ITIL v4)</span>
          <span class="text-zinc-950 dark:text-white">99.4% Éxito</span>
        </div>
        <p class="text-[11px] text-zinc-500">
          Más de 100 ventanas nocturnas de cambio (fibra, cobre, migración) ejecutadas con <strong>cero rollbacks</strong>.
        </p>
        <div class="w-full bg-zinc-200 dark:bg-zinc-800 rounded-full h-2">
          <div class="bg-zinc-950 dark:bg-white h-2 rounded-full w-[99.4%]"></div>
        </div>
      </div>

      <!-- Bloque 4: Disponibilidad de Misión Crítica (SLA) -->
      <div class="space-y-2 p-4 rounded-xl border border-zinc-200 dark:border-white/10 bg-zinc-50/70 dark:bg-white/5 font-mono text-xs">
        <div class="flex justify-between items-center text-zinc-800 dark:text-zinc-200 font-bold">
          <span>Disponibilidad Contractual (SLA)</span>
          <span class="text-zinc-950 dark:text-white">99.999% SLA</span>
        </div>
        <p class="text-[11px] text-zinc-500">
          Resguardo continuo de plataformas de banca, retail y gobierno: <strong>0.00 segundos</strong> de caída troncal.
        </p>
        <div class="w-full bg-zinc-200 dark:bg-zinc-800 rounded-full h-2">
          <div class="bg-zinc-950 dark:bg-white h-2 rounded-full w-[100%]"></div>
        </div>
      </div>

    </div>
  </div>

  <!-- Infraestructura a Gran Escala: ~1.000 Racks en 3 Data Centers Corporativos -->
  <div class="p-6 sm:p-7 rounded-2xl border border-zinc-200 dark:border-white/10 bg-white dark:bg-[#0f1118] shadow-sm reveal">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 pb-4 border-b border-zinc-100 dark:border-white/10">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="text-base">🏢</span>
          <h3 class="text-sm sm:text-base font-bold text-zinc-950 dark:text-white">
            Infraestructura Gestionada: ~1.000 Racks en 3 Data Centers
          </h3>
        </div>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 max-w-2xl">
          Supervisión integral de equipamiento en salas de Apoquindo, San Martín y Paine con un promedio del <strong class="text-zinc-950 dark:text-white font-semibold">70% de capacidad</strong> por rack, inventario en <strong class="text-zinc-950 dark:text-white font-semibold">NetBox DCIM</strong> y liderazgo sobre 20 operadores técnicos en turnos 24/7.
        </p>
      </div>

      <div class="flex items-center gap-2 font-mono text-xs flex-shrink-0">
        <span class="px-3 py-1 rounded-full border border-zinc-200 dark:border-white/10 bg-zinc-50 dark:bg-white/5 font-semibold text-zinc-800 dark:text-zinc-200">
          980 Racks Totales
        </span>
        <span class="px-3 py-1 rounded-full border border-zinc-200 dark:border-white/10 bg-zinc-50 dark:bg-white/5 font-semibold text-zinc-950 dark:text-white">
          70% Capacidad Media
        </span>
      </div>
    </div>

    <!-- 3 Data Centers Telemetry Grid -->
    <div class="grid md:grid-cols-3 gap-4 mb-5">
      {dcBreakdown.map((dc) => (
        <div class="p-4 rounded-xl border border-zinc-200/80 dark:border-white/10 bg-zinc-50/60 dark:bg-white/5">
          <div class="flex items-center justify-between mb-3 text-xs font-mono">
            <span class="font-bold text-zinc-950 dark:text-white">
              {dc.name}
            </span>
            <span class="text-[10px] text-zinc-900 dark:text-white font-semibold flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 dark:bg-white"></span>
              Normal
            </span>
          </div>

          <div class="space-y-2 mb-4 font-mono text-xs">
            <div class="flex justify-between text-zinc-500 dark:text-zinc-400">
              <span>Racks Operativos:</span>
              <span class="font-semibold text-zinc-950 dark:text-white">{dc.racks} Racks</span>
            </div>
            
            <div class="flex justify-between text-zinc-500 dark:text-zinc-400">
              <span>Capacidad Promedio:</span>
              <span class="font-semibold text-zinc-950 dark:text-white">{dc.capacity}%</span>
            </div>
            <div class="w-full bg-zinc-200 dark:bg-zinc-800 rounded-full h-1.5 overflow-hidden">
              <div class="bg-zinc-900 dark:bg-white h-1.5 rounded-full" style={`width: ${dc.capacity}%`}></div>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-2 pt-2.5 border-t border-zinc-200/60 dark:border-white/10 text-[10px] font-mono text-zinc-500 dark:text-zinc-400">
            <div>
              <span>Temp Pasillo Frío:</span>
              <span class="block font-semibold text-zinc-800 dark:text-zinc-200">{dc.temp}</span>
            </div>
            <div>
              <span>Carga Media PDU:</span>
              <span class="block font-semibold text-zinc-800 dark:text-zinc-200">{dc.pduLoad}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- NetBox & Cuadrilla 24/7 -->
    <div class="p-3.5 rounded-xl border border-zinc-200/80 dark:border-white/10 bg-zinc-50/80 dark:bg-white/5 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono">
      <div class="flex items-center gap-2 text-zinc-700 dark:text-zinc-300">
        <span class="text-zinc-950 dark:text-white">⚙️</span>
        <span>
          <strong>NetBox DCIM Integrado:</strong> Mapeo exacto de cables, puertos de switches, fibra óptica e inventario documentado en tiempo real.
        </span>
      </div>
      <div class="flex items-center gap-1.5 text-zinc-950 dark:text-white font-bold flex-shrink-0">
        <span>👥 Cuadrilla 24/7: 20 Operadores</span>
      </div>
    </div>
  </div>

</section>
