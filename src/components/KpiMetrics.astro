---
const coreKpis = [
  {
    id: "sla",
    metric: "99.999% SLA",
    subtitle: "Cero Caídas Troncales",
    detail: "Resguardo ininterrumpido de plataformas de cómputo, sistemas de respaldo de energía (UPS) y enlaces corporativos redundantes.",
    badge: "Alta Disponibilidad",
    badgeColor: "text-emerald-700 bg-emerald-100 border-emerald-300 dark:text-emerald-400 dark:bg-emerald-950/60 dark:border-emerald-800/60",
    barPercent: "100%",
    barColor: "from-emerald-500 to-cyan-400",
    telemetry: "DOWNTIME ANUAL: 0.00 seg",
    highlight: "SLA Troncal Cumplido"
  },
  {
    id: "mttr",
    metric: "-40% MTTR",
    subtitle: "< 15 min de Respuesta",
    detail: "Reducción del tiempo medio de atención y resolución en fallas críticas mediante estandarización rigurosa de procedimientos (SOPs).",
    badge: "Eficiencia N1/Senior",
    badgeColor: "text-cyan-700 bg-cyan-100 border-cyan-300 dark:text-cyan-400 dark:bg-cyan-950/60 dark:border-cyan-800/60",
    barPercent: "85%",
    barColor: "from-cyan-500 to-blue-500",
    telemetry: "ANTES: 25 min ➔ AHORA: < 15 min",
    highlight: "Resolución Acelerada"
  },
  {
    id: "rfc",
    metric: "99.4% Éxito",
    subtitle: "100+ Ventanas Nocturnas",
    detail: "Cableados de fibra/cobre, migraciones de racks y puestas en marcha ejecutadas sin rollbacks ni afectación de servicios a clientes.",
    badge: "Gestión de Cambios",
    badgeColor: "text-blue-700 bg-blue-100 border-blue-300 dark:text-blue-400 dark:bg-blue-950/60 dark:border-blue-800/60",
    barPercent: "99.4%",
    barColor: "from-blue-500 to-indigo-500",
    telemetry: "0 ROLLBACKS EN VENTANAS CRÍTICAS",
    highlight: "100+ Mantenimientos"
  },
  {
    id: "ops",
    metric: "24/7 Ops",
    subtitle: "Supervisión de Turnos",
    detail: "Coordinación técnica de 20 operadores en 3 Data Centers, control de bitácoras, traspasos sin puntos ciegos y auditoría de activos.",
    badge: "Liderazgo de Cuadrilla",
    badgeColor: "text-violet-700 bg-violet-100 border-violet-300 dark:text-violet-400 dark:bg-violet-950/60 dark:border-violet-800/60",
    barPercent: "100%",
    barColor: "from-violet-500 to-cyan-400",
    telemetry: "ROTACIÓN CONTINUA 365 DÍAS",
    highlight: "20 Operadores en 3 DCs"
  }
];

// Data Center Metrics Breakdown
const dcBreakdown = [
  { name: "Data Center Alpha (Principal)", racks: 420, capacity: 72, temp: "19.5°C", pduLoad: "68%" },
  { name: "Data Center Beta (Corporativo)", racks: 360, capacity: 69, temp: "20.1°C", pduLoad: "71%" },
  { name: "Data Center Gamma (Misión Crítica)", racks: 200, capacity: 70, temp: "19.2°C", pduLoad: "67%" },
];
---

<section id="telemetria" class="max-w-5xl mx-auto px-6 py-16 border-t border-slate-800/80 dark:border-slate-800/80 border-slate-200 transition-colors">
  
  <!-- Header / Badge -->
  <div class="mb-12 text-center sm:text-left">
    <div class="pro-badge mb-2">
      <span class="inline-flex items-center gap-2 bg-gradient-to-r from-cyan-400 to-emerald-400 dark:from-cyan-400 dark:to-emerald-400 from-blue-600 to-cyan-600 bg-clip-text text-transparent text-xs font-mono font-bold tracking-wider uppercase">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        ● TELEMETRÍA OPERACIONAL & RESULTADOS MEDIBLES
      </span>
    </div>
    
    <h2 class="text-2xl sm:text-4xl font-black text-slate-900 dark:text-white text-gradient-pro mb-3 tracking-tight">
      Gestión de Continuidad & Eficiencia Operativa en Data Centers
    </h2>
    
    <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 max-w-3xl leading-relaxed">
      Impacto cuantitativo liderando infraestructura de misión crítica, supervisión de cuadrillas 24/7 y mitigación sistemática de quiebres de servicio bajo marcos ITIL e ISO 27001.
    </p>
  </div>

  <!-- 4 Core KPI Cards Grid -->
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-12">
    {coreKpis.map((kpi) => (
      <div class="noc-kpi-card p-6 flex flex-col justify-between group cursor-default shadow-md">
        <div>
          <!-- Header Bar with badge and live icon -->
          <div class="flex items-center justify-between mb-4">
            <span class={`text-[10px] font-mono font-bold px-2.5 py-0.5 rounded-full border ${kpi.badgeColor}`}>
              {kpi.badge}
            </span>
            <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 dark:bg-emerald-400 group-hover:scale-125 transition-transform duration-300"></div>
          </div>

          <!-- Big Metric Number -->
          <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight mb-1 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors font-mono">
            {kpi.metric}
          </div>

          <!-- Subtitle -->
          <div class="text-xs font-bold text-cyan-700 dark:text-cyan-300 mb-2">
            {kpi.subtitle}
          </div>

          <!-- Detail paragraph -->
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            {kpi.detail}
          </p>
        </div>

        <!-- Telemetry bar & micro-metric footer -->
        <div class="pt-3 border-t border-slate-200 dark:border-slate-800">
          <div class="flex items-center justify-between text-[10px] font-mono text-slate-600 dark:text-slate-400 mb-1.5 font-semibold">
            <span class="truncate">{kpi.telemetry}</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-bold">{kpi.barPercent}</span>
          </div>
          <div class="w-full bg-slate-200 dark:bg-slate-800 rounded-full h-2 overflow-hidden">
            <div 
              class={`bg-gradient-to-r ${kpi.barColor} h-2 rounded-full transition-all duration-700 group-hover:opacity-100 opacity-90`}
              style={`width: ${kpi.barPercent}`}
            ></div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Real Operational Achievements & Data Visualizations (Hiberus / Data Centers) -->
  <div class="space-y-8">
    
    <!-- Section Sub-header -->
    <div class="flex items-center gap-3 pb-3 border-b border-slate-300 dark:border-slate-800">
      <span class="text-base font-mono font-bold text-slate-900 dark:text-white flex items-center gap-2">
        <span class="text-cyan-600 dark:text-cyan-400">📊</span>
        PANEL DE LOGROS TÉCNICOS & CONTROL DE GESTIÓN OPERACIONAL
      </span>
      <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hidden md:inline">
        Supervisión Activa & DCIM NetBox
      </span>
    </div>

    <!-- 2 Columns Grid for Live Charts / Dashboards -->
    <div class="grid lg:grid-cols-2 gap-6">

      <!-- Chart 1: SLA de Primera Respuesta (<10 min) & Alertas con Power Automate/Power BI -->
      <div class="pro-card p-6 sm:p-7 rounded-2xl flex flex-col justify-between shadow-md">
        <div>
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">
                Tiempos de Primera Respuesta & Control de Desviaciones
              </h3>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-800/60 font-bold">
              Meta: &lt; 10 min
            </span>
          </div>

          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-5">
            Creación de hábitos en el equipo con generación inmediata de ticket y respuesta con avances al cliente dentro de los <strong class="text-slate-900 dark:text-white">10 minutos</strong>. Integración de seguimiento automatizado mediante <strong class="text-cyan-700 dark:text-cyan-400">Power Automate</strong>, alertas automáticas por correo y tableros en <strong class="text-cyan-700 dark:text-cyan-400">Power BI</strong> que anticipan quiebres de SLA.
          </p>

          <!-- Visual Graph: Time Reduction Comparison -->
          <div class="space-y-3 bg-slate-50 dark:bg-slate-950/70 p-4 rounded-xl border border-slate-200 dark:border-slate-800/80 mb-5 font-mono text-xs">
            <div>
              <div class="flex justify-between text-slate-600 dark:text-slate-400 mb-1">
                <span>Tiempo Anterior (Sin Estandarización):</span>
                <span class="text-rose-600 dark:text-rose-400 font-bold">25 - 30 min</span>
              </div>
              <div class="w-full bg-slate-200 dark:bg-slate-800 rounded-full h-3 overflow-hidden">
                <div class="bg-rose-500/80 h-3 rounded-full w-[90%]"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-slate-700 dark:text-slate-200 mb-1 font-bold">
                <span class="flex items-center gap-1.5 text-emerald-700 dark:text-emerald-400">
                  <span>✔</span> Tiempo Actual con SOPs & Automatizaciones:
                </span>
                <span class="text-emerald-600 dark:text-emerald-400">&lt; 10 min (Logrado)</span>
              </div>
              <div class="w-full bg-slate-200 dark:bg-slate-800 rounded-full h-3 overflow-hidden">
                <div class="bg-gradient-to-r from-emerald-500 to-cyan-400 h-3 rounded-full w-[33%]"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 pt-3 border-t border-slate-200 dark:border-slate-800 text-[11px] font-mono">
          <div class="p-2.5 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <span class="text-slate-500 dark:text-slate-400 block text-[10px]">Trazabilidad</span>
            <span class="font-bold text-slate-900 dark:text-white">Power BI & Ticketing</span>
          </div>
          <div class="p-2.5 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <span class="text-slate-500 dark:text-slate-400 block text-[10px]">Alertas Tempranas</span>
            <span class="font-bold text-emerald-600 dark:text-emerald-400">Cero Quiebres Críticos</span>
          </div>
        </div>
      </div>

      <!-- Chart 2: Modelo de Factibilidades Técnicas (+90% Efectividad) -->
      <div class="pro-card p-6 sm:p-7 rounded-2xl flex flex-col justify-between shadow-md">
        <div>
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-cyan-500"></span>
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">
                Modelos de Factibilidad Técnica & Trazabilidad
              </h3>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-100 dark:bg-cyan-950/80 text-cyan-800 dark:text-cyan-400 border border-cyan-300 dark:border-cyan-800/60 font-bold">
              +90% Efectividad
            </span>
          </div>

          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-5">
            Implementación de modelos estructurados para evaluación de factibilidades técnicas y tiempos de respuesta. Se logró un incremento del <strong class="text-slate-900 dark:text-white">+90% en la efectividad operativa</strong>, manteniendo trazabilidad completa de reservas de clientes, stock de insumos y controles de cambio (RFCs).
          </p>

          <!-- Visual Bar Chart: Feasibility Efficiency -->
          <div class="space-y-3 bg-slate-50 dark:bg-slate-950/70 p-4 rounded-xl border border-slate-200 dark:border-slate-800/80 mb-5 font-mono text-xs">
            <div>
              <div class="flex justify-between text-slate-600 dark:text-slate-400 mb-1">
                <span>Efectividad en Asignación & Reservas:</span>
                <span class="text-cyan-700 dark:text-cyan-400 font-bold">94%</span>
              </div>
              <div class="w-full bg-slate-200 dark:bg-slate-800 rounded-full h-3 overflow-hidden">
                <div class="bg-gradient-to-r from-blue-500 to-cyan-400 h-3 rounded-full w-[94%]"></div>
              </div>
            </div>

            <div>
              <div class="flex justify-between text-slate-600 dark:text-slate-400 mb-1">
                <span>Precisión de Inventario Físico vs Sistema:</span>
                <span class="text-emerald-700 dark:text-emerald-400 font-bold">98.5%</span>
              </div>
              <div class="w-full bg-slate-200 dark:bg-slate-800 rounded-full h-3 overflow-hidden">
                <div class="bg-gradient-to-r from-emerald-500 to-cyan-400 h-3 rounded-full w-[98.5%]"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3 pt-3 border-t border-slate-200 dark:border-slate-800 text-[11px] font-mono">
          <div class="p-2.5 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <span class="text-slate-500 dark:text-slate-400 block text-[10px]">Control de Cambios</span>
            <span class="font-bold text-slate-900 dark:text-white">100% Trazable RFC</span>
          </div>
          <div class="p-2.5 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <span class="text-slate-500 dark:text-slate-400 block text-[10px]">Reservas Clientes</span>
            <span class="font-bold text-cyan-600 dark:text-cyan-400">Stock Sin Solapamiento</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Chart 3 (Full Width): Gestión de ~1.000 Racks en 3 Data Centers & NetBox DCIM -->
    <div class="pro-card p-6 sm:p-8 rounded-2xl shadow-md border border-slate-300 dark:border-slate-800">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-200 dark:border-slate-800">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-lg">🏢</span>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">
              Infraestructura a Gran Escala: ~1.000 Racks en 3 Data Centers Corporativos
            </h3>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-300">
            Supervisión integral de equipamiento con promedio del <strong class="text-slate-900 dark:text-white">70% de capacidad operativa</strong> por rack, integración en sistema open-source <strong class="text-cyan-700 dark:text-cyan-400">NetBox DCIM</strong> y liderazgo sobre cuadrilla de 20 operadores técnicos en turnos 24/7.
          </p>
        </div>

        <div class="flex items-center gap-2 flex-shrink-0">
          <span class="px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-900 text-xs font-mono font-bold text-cyan-700 dark:text-cyan-400 border border-slate-300 dark:border-slate-800">
            980 Racks Totales
          </span>
          <span class="px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-900 text-xs font-mono font-bold text-emerald-700 dark:text-emerald-400 border border-slate-300 dark:border-slate-800">
            70% Capacidad Media
          </span>
        </div>
      </div>

      <!-- 3 Data Centers Telemetry Grid -->
      <div class="grid md:grid-cols-3 gap-5">
        {dcBreakdown.map((dc, i) => (
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800/80">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold text-slate-900 dark:text-white font-mono">
                {dc.name}
              </span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-800 font-semibold">
                ● Normal
              </span>
            </div>

            <!-- Rack Volume & Load -->
            <div class="space-y-2 mb-4 font-mono text-xs">
              <div class="flex justify-between text-slate-600 dark:text-slate-400">
                <span>Racks Operativos:</span>
                <span class="font-bold text-slate-900 dark:text-white">{dc.racks} Racks</span>
              </div>
              
              <div class="flex justify-between text-slate-600 dark:text-slate-400">
                <span>Capacidad Promedio:</span>
                <span class="font-bold text-cyan-700 dark:text-cyan-400">{dc.capacity}%</span>
              </div>
              <div class="w-full bg-slate-200 dark:bg-slate-800 rounded-full h-2 overflow-hidden">
                <div 
                  class="bg-gradient-to-r from-cyan-500 to-emerald-400 h-2 rounded-full"
                  style={`width: ${dc.capacity}%`}
                ></div>
              </div>
            </div>

            <!-- DC Environmental & Power Telemetry -->
            <div class="grid grid-cols-2 gap-2 pt-3 border-t border-slate-200 dark:border-slate-800 text-[10px] font-mono text-slate-600 dark:text-slate-400">
              <div>
                <span>Temp Pasillo Frío:</span>
                <span class="block font-bold text-slate-900 dark:text-slate-200">{dc.temp}</span>
              </div>
              <div>
                <span>Carga Media PDU:</span>
                <span class="block font-bold text-slate-900 dark:text-slate-200">{dc.pduLoad}</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- NetBox & 24/7 Team Integration Callout -->
      <div class="mt-6 p-4 rounded-xl bg-slate-100 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono">
        <div class="flex items-center gap-3">
          <span class="text-cyan-600 dark:text-cyan-400 text-base">⚙️</span>
          <span class="text-slate-700 dark:text-slate-300">
            <strong>NetBox DCIM Integrado:</strong> Mapeo exacto de cables, puertos de switches, fibra óptica e inventario de activos documentado en tiempo real.
          </span>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0 text-emerald-700 dark:text-emerald-400 font-bold">
          <span>👥 Cuadrilla 24/7: 20 Operadores</span>
        </div>
      </div>
    </div>

  </div>

</section>
