---
const aiTools = [
  { symbol: "⌘", name: "Antigravity", desc: "Desarrollo agéntico autónomo" },
  { symbol: "⌘", name: "Claude Code", desc: "CLI & Terminal Agentic Coding" },
  { symbol: "⌘", name: "OpenAI / LLMs", desc: "Modelos avanzados, embeddings & APIs" },
  { symbol: "⌘", name: "Ollama", desc: "Inferencia local en servidores propios" },
  { symbol: "⌘", name: "Agentes Autónomos", desc: "Flujos de decisión y auditoría técnica" },
  { symbol: "⌘", name: "Cursor & Copilot", desc: "Programación contextual asistida por IA" },
  { symbol: "⌘", name: "DeepSeek", desc: "Modelos abiertos y optimización de prompts" },
];

const techSkills = [
  { symbol: "⚡", name: "Python", desc: "Automatización de procesos, scripts y data" },
  { symbol: "🗄️", name: "SQL Relacional", desc: "MySQL, PostgreSQL y consultas analíticas" },
  { symbol: "🐧", name: "Linux / Bash", desc: "SysAdmin, gestión de servidores y shell" },
  { symbol: "📦", name: "NetBox DCIM", desc: "Mapeo de racks, IPAM y activos de red" },
  { symbol: "📊", name: "Power BI & Automate", desc: "Telemetría de SLA y alertas tempranas" },
  { symbol: "🐳", name: "Docker", desc: "Contenedores y despliegues reproducibles" },
  { symbol: "⚡", name: "JavaScript / Node", desc: "Servicios web y desarrollo modular" },
  { symbol: "🐘", name: "PHP / Laravel", desc: "Arquitectura backend estructurada MVC" },
  { symbol: "🎨", name: "Tailwind CSS", desc: "Diseño minimalista y maquetación responsiva" },
  { symbol: "🛡️", name: "ITIL & ISO 27001", desc: "Procedimientos SOPs, DRP y controles RFC" },
];

const softSkills = [
  "Liderazgo de Cuadrillas 24/7 (20 Operadores)",
  "Gestión de Quiebres & Análisis Causa Raíz (RCA)",
  "Estandarización de Procedimientos (SOPs)",
  "Resguardo Irrestricto de SLAs (99.999%)",
  "Trazabilidad de Cambios & Auditorías ISO 27001",
  "Comunicación Asertiva y Hábitos de Respuesta Rápida"
];
---

<section id="habilidades" class="max-w-5xl mx-auto px-6 py-16 border-t border-zinc-200 dark:border-white/10 transition-colors reveal">
  
  <!-- Minimalist Section Header -->
  <div class="mb-10">
    <div class="inline-flex items-center gap-2 mb-2 font-mono text-xs uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400 font-semibold">
      <span>●</span>
      <span>Stack Tecnológico & Metodologías</span>
    </div>
    <h2 class="text-2xl sm:text-4xl font-heading font-bold text-zinc-950 dark:text-white tracking-tight mb-2">
      Herramientas Técnicas & Automatización
    </h2>
    <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
      Carruseles continuos interactivos de tecnologías activas aplicadas en ingeniería de centros de datos, desarrollo a medida y flujos autónomos con IA.
    </p>
  </div>

  <!-- Carousel Row 1: Herramientas de Inteligencia Artificial & Agentes -->
  <div class="mb-4">
    <div class="marquee-container py-1.5">
      <div class="animate-marquee-left gap-3 flex items-center">
        {[...aiTools, ...aiTools, ...aiTools, ...aiTools].map((tool) => (
          <div class="flex-shrink-0 flex items-center gap-2.5 px-4 py-2.5 rounded-full border border-zinc-200 dark:border-white/10 bg-white dark:bg-white/5 shadow-sm hover:border-zinc-500 dark:hover:border-white/30 transition-colors cursor-default">
            <span class="text-xs font-mono text-zinc-900 dark:text-white font-bold">{tool.symbol}</span>
            <span class="text-xs font-mono text-zinc-700 dark:text-zinc-300 whitespace-nowrap">
              <strong class="text-zinc-950 dark:text-white font-semibold">{tool.name}</strong> — {tool.desc}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Carousel Row 2: Desarrollo, Frameworks & Infraestructura -->
  <div class="mb-12">
    <div class="marquee-container py-1.5">
      <div class="animate-marquee-right gap-3 flex items-center">
        {[...techSkills, ...techSkills, ...techSkills, ...techSkills].map((tech) => (
          <div class="flex-shrink-0 flex items-center gap-2.5 px-4 py-2.5 rounded-full border border-zinc-200 dark:border-white/10 bg-white dark:bg-white/5 shadow-sm hover:border-zinc-500 dark:hover:border-white/30 transition-colors cursor-default">
            <span class="text-xs flex-shrink-0">{tech.symbol}</span>
            <span class="text-xs font-mono text-zinc-700 dark:text-zinc-300 whitespace-nowrap">
              <strong class="text-zinc-950 dark:text-white font-semibold">{tech.name}</strong> — {tech.desc}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Habilidades Personales, Liderazgo & Metodología -->
  <div class="pt-6 border-t border-zinc-200/80 dark:border-white/10">
    <div class="flex items-center gap-2 mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 dark:bg-white"></span>
      <h3 class="text-xs font-mono uppercase tracking-[0.15em] text-zinc-700 dark:text-zinc-300 font-bold">
        Habilidades Operativas, Liderazgo & Metodología
      </h3>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {softSkills.map((skill) => (
        <div class="flex items-center gap-2.5 px-4 py-3 rounded-xl border border-zinc-200 dark:border-white/10 bg-white dark:bg-white/5 text-zinc-800 dark:text-zinc-200 text-xs font-mono font-medium shadow-sm hover:border-zinc-400 dark:hover:border-white/25 transition-colors">
          <span class="text-zinc-900 dark:text-white font-bold flex-shrink-0 text-xs">✔</span>
          <span class="truncate">{skill}</span>
        </div>
      ))}
    </div>
  </div>

</section>
