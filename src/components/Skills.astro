---
const aiTools = [
  { symbol: "⌘", name: "Antigravity", desc: "Desarrollo agéntico autónomo" },
  { symbol: "⌘", name: "Claude Code", desc: "CLI & Terminal Agentic Coding" },
  { symbol: "⌘", name: "OpenAI / LLMs", desc: "Modelos avanzados, embeddings & APIs" },
  { symbol: "⌘", name: "Ollama", desc: "Inferencia local en servidores propios" },
  { symbol: "⌘", name: "Agentes Autónomos", desc: "Flujos de decisión y auditoría técnica" },
  { symbol: "⌘", name: "Cursor & Copilot", desc: "Programación contextual asistida por IA" },
  { symbol: "⌘", name: "DeepSeek", desc: "Modelos abiertos y optimización de prompts" },
];

const techSkills = [
  { symbol: "🐍", name: "Python", desc: "Automatización de procesos, scripts y data" },
  { symbol: "🗄️", name: "SQL Relacional", desc: "MySQL, PostgreSQL y consultas analíticas" },
  { symbol: "🐧", name: "Linux / Bash", desc: "SysAdmin, gestión de servidores y shell" },
  { symbol: "📦", name: "NetBox DCIM", desc: "Mapeo de racks, IPAM y activos de red" },
  { symbol: "📊", name: "Power BI & Automate", desc: "Telemetría de SLA y alertas tempranas" },
  { symbol: "🐳", name: "Docker", desc: "Contenedores y despliegues reproducibles" },
  { symbol: "⚡", name: "JavaScript / Node", desc: "Servicios web y desarrollo modular" },
  { symbol: "🐘", name: "PHP / Laravel", desc: "Arquitectura backend estructurada MVC" },
  { symbol: "🎨", name: "Tailwind CSS", desc: "Diseño minimalista y maquetación responsiva" },
  { symbol: "🛡️", name: "ITIL & ISO 27001", desc: "Procedimientos SOPs, DRP y controles RFC" },
];

const softSkills = [
  "Liderazgo de Cuadrillas 24/7 (20 Operadores)",
  "Gestión de Quiebres & Análisis Causa Raíz (RCA)",
  "Estandarización de Procedimientos (SOPs)",
  "Resguardo Irrestricto de SLAs (99.999%)",
  "Trazabilidad de Cambios & Auditorías ISO 27001",
  "Comunicación Asertiva y Hábitos de Respuesta Rápida"
];
---

<section id="habilidades" class="max-w-5xl mx-auto px-6 py-14 border-t border-slate-200 dark:border-slate-800/80 transition-colors">
  
  <!-- Minimalist Section Header (Rob Bowen Digital style) -->
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 mb-2 font-mono text-xs uppercase tracking-wider text-violet-700 dark:text-violet-400 font-semibold">
      <span>●</span>
      <span>Stack Tecnológico & Metodologías</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 dark:text-white tracking-tight mb-2">
      Herramientas Técnicas & Automatización
    </h2>
    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
      Carrusel pausado de tecnologías activas aplicadas en ingeniería de operaciones de centros de datos, desarrollo a medida y automatizaciones con IA.
    </p>
  </div>

  <!-- Carousel Row 1: Herramientas de Inteligencia Artificial & Agentes (Solo Símbolo y Descripción) -->
  <div class="mb-4">
    <div class="marquee-container py-1.5">
      <div class="animate-marquee-left gap-3 flex items-center">
        {[...aiTools, ...aiTools, ...aiTools, ...aiTools].map((tool) => (
          <div class="flex-shrink-0 flex items-center gap-2.5 px-3.5 py-2 rounded-lg border border-slate-200 dark:border-slate-800/90 bg-white/90 dark:bg-slate-900/60 shadow-sm hover:border-violet-500/50 transition-colors cursor-default">
            <span class="text-xs font-mono text-violet-600 dark:text-violet-400 font-bold">{tool.symbol}</span>
            <span class="text-xs font-mono text-slate-700 dark:text-slate-300 whitespace-nowrap">
              <strong class="text-slate-900 dark:text-white font-semibold">{tool.name}</strong> — {tool.desc}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Carousel Row 2: Desarrollo, Frameworks & Infraestructura (Solo Símbolo y Descripción) -->
  <div class="mb-10">
    <div class="marquee-container py-1.5">
      <div class="animate-marquee-right gap-3 flex items-center">
        {[...techSkills, ...techSkills, ...techSkills, ...techSkills].map((tech) => (
          <div class="flex-shrink-0 flex items-center gap-2.5 px-3.5 py-2 rounded-lg border border-slate-200 dark:border-slate-800/90 bg-white/90 dark:bg-slate-900/60 shadow-sm hover:border-sky-500/50 transition-colors cursor-default">
            <span class="text-sm flex-shrink-0">{tech.symbol}</span>
            <span class="text-xs font-mono text-slate-700 dark:text-slate-300 whitespace-nowrap">
              <strong class="text-slate-900 dark:text-white font-semibold">{tech.name}</strong> — {tech.desc}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Habilidades Personales, Liderazgo & Metodología -->
  <div class="pt-4 border-t border-slate-200/60 dark:border-slate-800/60">
    <div class="flex items-center gap-2 mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
      <h3 class="text-xs font-mono uppercase tracking-wider text-slate-700 dark:text-slate-300 font-bold">
        Habilidades Personales, Liderazgo & Metodología
      </h3>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-2.5">
      {softSkills.map((skill) => (
        <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-lg border border-slate-200 dark:border-slate-800/80 bg-white/70 dark:bg-slate-900/40 text-slate-800 dark:text-slate-200 text-xs font-mono font-medium shadow-sm hover:border-emerald-500/40 transition-colors">
          <span class="text-emerald-600 dark:text-emerald-400 font-bold flex-shrink-0 text-xs">✔</span>
          <span class="truncate">{skill}</span>
        </div>
      ))}
    </div>
  </div>

</section>
