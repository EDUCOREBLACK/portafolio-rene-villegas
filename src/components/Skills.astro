---
const techSkills = [
  { name: "Python", category: "Lenguaje / Automatización", icon: "🐍" },
  { name: "PHP", category: "Backend / MVC", icon: "🐘" },
  { name: "JavaScript", category: "Frontend / Node", icon: "⚡" },
  { name: "CSS3 & Tailwind", category: "Diseño & UI", icon: "🎨" },
  { name: "Laravel", category: "Framework PHP", icon: "🔥" },
  { name: "Django", category: "Framework Python", icon: "🚀" },
  { name: "Yii2", category: "Framework PHP", icon: "⚙️" },
  { name: "MongoDB", category: "NoSQL Database", icon: "🍃" },
  { name: "SQL Relacional", category: "MySQL / PostgreSQL", icon: "🗄️" },
  { name: "Linux / Bash", category: "SysAdmin & Shell", icon: "🐧" },
  { name: "Docker", category: "Contenedores & CI", icon: "🐳" },
  { name: "WordPress", category: "CMS & E-commerce", icon: "🌐" },
];

const aiTools = [
  { name: "Antigravity", badge: "Google DeepMind", desc: "Desarrollo agéntico avanzado y generación de código", icon: "antigravity" },
  { name: "Claude Code", badge: "Anthropic", desc: "Codificación autónoma en terminal CLI y revisión de arquitectura", icon: "claude" },
  { name: "OpenAI / LLMs", badge: "Modelos de Lenguaje", desc: "Integración de embeddings, razonamiento y APIs avanzadas", icon: "openai" },
  { name: "Ollama & Modelos Locales", badge: "On-Premise", desc: "Inferencia privada local en infraestructura corporativa", icon: "ollama" },
  { name: "Agentes & Workflows", badge: "Automatización", desc: "Orquestación de flujos de auditoría y análisis de datos", icon: "agent" },
];

const softSkills = [
  "Liderazgo de Operaciones Críticas 24/7",
  "Resolución Rápida bajo Presión",
  "Análisis de Causa Raíz (RCA)",
  "Comunicación Asertiva & Trabajo en Equipo",
  "Compromiso Irrestricto con SLAs",
  "Adaptabilidad a Nuevos Marcos Tecnológicos"
];
---

<section id="habilidades" class="max-w-5xl mx-auto px-6 py-16 border-t border-gray-800/80">
  <!-- Section Badge & Header -->
  <div class="mb-12 text-center sm:text-left">
    <div class="pro-badge mb-2">
      <span class="bg-gradient-to-r from-indigo-400 to-indigo-200 bg-clip-text text-transparent text-xs font-mono font-semibold tracking-wider uppercase">
        Competencias Técnicas & AI Stack
      </span>
    </div>
    <h2 class="text-2xl sm:text-4xl font-bold text-gradient-pro mb-3">
      Habilidades & Ecosistema Tecnológico
    </h2>
    <p class="text-xs sm:text-sm text-gray-400 max-w-2xl leading-relaxed">
      Sólido dominio en infraestructura de centros de datos, lenguajes de desarrollo web, bases de datos y la vanguardia en herramientas de Inteligencia Artificial agéntica.
    </p>
  </div>

  <!-- AI Ecosystem (Cruip Open PRO Style) -->
  <div class="mb-14">
    <div class="flex items-center gap-2 mb-5">
      <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
      <h3 class="text-xs font-mono uppercase tracking-wider text-indigo-400 font-semibold">
        Herramientas de Inteligencia Artificial & Agentes
      </h3>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {aiTools.map((tool) => (
        <div class="pro-card p-5 rounded-2xl border border-gray-800/80 hover:border-indigo-500/50 group flex items-start gap-4 transition-all">
          <div class="w-10 h-10 rounded-xl bg-indigo-950/60 border border-indigo-800/40 text-indigo-400 flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-hover:border-indigo-500 transition-all">
            {tool.icon === 'antigravity' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
              </svg>
            )}
            {tool.icon === 'claude' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 3a9 9 0 0 0-9 9c0 3.6 2.1 6.7 5.2 8.1.4.1.6-.2.6-.4v-1.5c-2.5.5-3-1.2-3-1.2-.4-1.1-1-1.4-1-1.4-.8-.6.1-.6.1-.6.9.1 1.4 1 1.4 1 .8 1.4 2.1 1 2.6.8.1-.6.3-1 .6-1.3-2-.2-4.1-1-4.1-4.5 0-1 .3-1.8.9-2.5-.1-.2-.4-1.2.1-2.5 0 0 .8-.2 2.6 1 .7-.2 1.5-.3 2.3-.3.8 0 1.6.1 2.3.3 1.8-1.2 2.6-1 2.6-1 .5 1.3.2 2.3.1 2.5.6.7.9 1.5.9 2.5 0 3.5-2.1 4.3-4.1 4.5.3.3.6.8.6 1.7v2.5c0 .2.2.5.6.4A9 9 0 0 0 21 12a9 9 0 0 0-9-9z"/>
              </svg>
            )}
            {tool.icon === 'openai' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"/>
                <path d="M12 3v3m0 12v3m9-9h-3M6 12H3m15.364-6.364l-2.121 2.121M7.757 16.243l-2.121 2.121m12.728 0l-2.121-2.121M7.757 7.757L5.636 5.636"/>
              </svg>
            )}
            {tool.icon === 'ollama' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="4" y="4" width="16" height="16" rx="3"/>
                <path d="M9 9h6v6H9z"/>
              </svg>
            )}
            {tool.icon === 'agent' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
              </svg>
            )}
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <h4 class="text-xs sm:text-sm font-bold text-gray-100 group-hover:text-indigo-400 transition-colors">
                {tool.name}
              </h4>
              <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-gray-900 text-indigo-300 border border-gray-800">
                {tool.badge}
              </span>
            </div>
            <p class="text-xs text-gray-400 leading-snug">
              {tool.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Languages, Frameworks & Infra -->
  <div class="mb-14">
    <div class="flex items-center gap-2 mb-5">
      <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
      <h3 class="text-xs font-mono uppercase tracking-wider text-indigo-400 font-semibold">
        Desarrollo, Frameworks & Infraestructura
      </h3>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
      {techSkills.map((tech) => (
        <div class="pro-card p-3.5 rounded-xl border border-gray-800/80 hover:border-indigo-500/50 flex flex-col items-center justify-center text-center group transition-all">
          <span class="text-lg mb-1.5">{tech.icon}</span>
          <span class="text-xs font-bold text-gray-200 group-hover:text-indigo-400 transition-colors mb-0.5">
            {tech.name}
          </span>
          <span class="text-[10px] font-mono text-gray-500">
            {tech.category}
          </span>
        </div>
      ))}
    </div>
  </div>

  <!-- Habilidades Blandas / Gestión -->
  <div>
    <div class="flex items-center gap-2 mb-5">
      <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
      <h3 class="text-xs font-mono uppercase tracking-wider text-indigo-400 font-semibold">
        Habilidades Blandas & Gestión Operacional
      </h3>
    </div>

    <div class="flex flex-wrap gap-2.5">
      {softSkills.map((skill) => (
        <span class="text-xs font-mono px-3.5 py-1.5 rounded-xl pro-card border border-gray-800 text-gray-300 hover:border-indigo-500/50 hover:text-white transition-all flex items-center gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>{skill}</span>
        </span>
      ))}
    </div>
  </div>

</section>
