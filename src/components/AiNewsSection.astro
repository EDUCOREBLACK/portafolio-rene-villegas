---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const recentPosts = allPosts.slice(0, 3);
---

<section id="blog-ia" class="max-w-5xl mx-auto px-6 py-20 border-t border-brand-border">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
    <div>
      <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-brand-accent mb-2">
        <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span>
        Actualidad, IA & Tecnología
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-brand-text">Blog & Noticias de IA</h2>
    </div>

    <div class="flex items-center gap-4">
      <a 
        href="/mantenedor" 
        class="inline-flex items-center gap-1.5 text-xs font-mono px-3 py-1.5 rounded-lg border border-brand-border bg-brand-card hover:border-brand-accent hover:text-brand-accent text-brand-muted transition-colors"
        title="Panel para redactar y gestionar nuevos artículos"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        Mantenedor
      </a>

      <a 
        href="/blog" 
        class="text-xs font-mono text-brand-accent hover:underline flex items-center gap-1"
      >
        <span>Ver todos los artículos</span>
        <span>→</span>
      </a>
    </div>
  </div>

  <div class="grid md:grid-cols-3 gap-6">
    {recentPosts.map((post) => (
      <article class="bg-brand-card p-6 rounded-xl border border-brand-border hover:border-brand-borderHover hover:bg-brand-cardHover transition-all duration-200 flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between text-[11px] font-mono text-brand-muted mb-3">
            <span>{post.data.pubDate.toLocaleDateString('es-ES', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            <span class="text-brand-accent">{post.data.tags[0] || 'Tecnología'}</span>
          </div>

          <h3 class="text-base font-bold text-brand-text group-hover:text-brand-accent transition-colors mb-3 line-clamp-2">
            {post.data.title}
          </h3>

          <p class="text-xs text-brand-muted leading-relaxed line-clamp-3 mb-6">
            {post.data.description}
          </p>
        </div>

        <div class="pt-4 border-t border-brand-border/60 flex items-center justify-between text-xs font-mono">
          <span class="text-brand-muted text-[11px]">Por {post.data.author}</span>
          <a href="/blog" class="text-brand-accent group-hover:translate-x-1 transition-transform">
            Leer →
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
