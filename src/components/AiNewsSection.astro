---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const recentPosts = allPosts.slice(0, 3);
---

<section id="blog-ia" class="max-w-5xl mx-auto px-6 py-16 border-t border-slate-800/80 dark:border-slate-800/80 border-slate-200 transition-colors">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
    <div>
      <div class="pro-badge mb-2">
        <span class="inline-flex items-center gap-2 bg-gradient-to-r from-cyan-400 to-emerald-400 dark:from-cyan-400 dark:to-emerald-400 from-blue-600 to-cyan-600 bg-clip-text text-transparent text-xs font-mono font-bold tracking-wider uppercase">
          Actualidad & Publicaciones
        </span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white text-gradient-pro tracking-tight">
        Blog & Artículos Técnicos de IA
      </h2>
    </div>

    <a 
      href="/blog" 
      class="text-xs font-mono text-cyan-600 dark:text-cyan-400 hover:text-cyan-500 dark:hover:text-cyan-300 flex items-center gap-1.5 font-bold group"
    >
      <span>Ver todos los artículos</span>
      <span class="group-hover:translate-x-1 transition-transform">→</span>
    </a>
  </div>

  <div class="grid md:grid-cols-3 gap-5">
    {recentPosts.map((post) => (
      <article class="pro-card p-6 rounded-2xl flex flex-col justify-between group">
        <div>
          <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 dark:text-slate-400 mb-3">
            <span>{post.data.pubDate.toLocaleDateString('es-ES', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            <span class="text-cyan-600 dark:text-cyan-400 bg-cyan-50 dark:bg-cyan-950/60 px-2.5 py-0.5 rounded-full border border-cyan-200 dark:border-cyan-800/40 font-semibold">
              {post.data.tags[0] || 'Tecnología'}
            </span>
          </div>

          <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors mb-3 line-clamp-2">
            {post.data.title}
          </h3>

          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-3 mb-6">
            {post.data.description}
          </p>
        </div>

        <div class="pt-4 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between text-xs font-mono">
          <span class="text-slate-500 dark:text-slate-400 text-[11px]">Por {post.data.author}</span>
          <a href="/blog" class="text-cyan-600 dark:text-cyan-400 group-hover:translate-x-1 transition-transform font-bold">
            Leer →
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
