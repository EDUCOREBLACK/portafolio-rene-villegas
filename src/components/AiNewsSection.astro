---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const recentPosts = allPosts.slice(0, 3);
---

<section id="blog-ia" class="max-w-5xl mx-auto px-6 py-16 border-t border-zinc-200 dark:border-white/10 transition-colors reveal">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
    <div>
      <div class="inline-flex items-center gap-2 mb-2 font-mono text-xs uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400 font-semibold">
        <span>●</span>
        <span>Actualidad & Publicaciones</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-heading font-bold text-zinc-950 dark:text-white tracking-tight">
        Blog & Artículos Técnicos de IA
      </h2>
    </div>

    <a 
      href="/blog" 
      class="text-xs font-mono text-zinc-900 dark:text-white hover:opacity-75 flex items-center gap-1.5 font-bold group uppercase tracking-wider"
    >
      <span>Ver todos los artículos</span>
      <span class="group-hover:translate-x-1 transition-transform">→</span>
    </a>
  </div>

  <div class="grid md:grid-cols-3 gap-5">
    {recentPosts.map((post, index) => (
      <article class={`pro-card p-6 rounded-2xl flex flex-col justify-between group reveal ${index > 0 ? 'reveal-delay-' + index : ''}`}>
        <div>
          <div class="flex items-center justify-between text-[11px] font-mono text-zinc-500 dark:text-zinc-400 mb-3">
            <span>{post.data.pubDate.toLocaleDateString('es-ES', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            <span class="text-zinc-950 dark:text-white bg-zinc-100 dark:bg-white/10 px-2.5 py-0.5 rounded-full border border-zinc-200 dark:border-white/15 font-semibold text-[10px] uppercase">
              {post.data.tags[0] || 'Tecnología'}
            </span>
          </div>

          <h3 class="text-base font-bold text-zinc-950 dark:text-white group-hover:text-zinc-700 dark:group-hover:text-zinc-300 transition-colors mb-3 line-clamp-2">
            {post.data.title}
          </h3>

          <p class="text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed line-clamp-3 mb-6">
            {post.data.description}
          </p>
        </div>

        <div class="pt-4 border-t border-zinc-200 dark:border-white/10 flex items-center justify-between text-xs font-mono">
          <span class="text-zinc-500 dark:text-zinc-400 text-[11px]">Por {post.data.author}</span>
          <a href="/blog" class="text-zinc-950 dark:text-white group-hover:translate-x-1 transition-transform font-bold">
            Leer →
          </a>
        </div>
      </article>
    ))}
  </div>
</section>
