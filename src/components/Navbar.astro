---
const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Experiencia', href: '/#experiencia' },
  { label: 'Noticias IA', href: '/#blog-ia' },
  { label: 'GitHub', href: '/#github' },
  { label: 'Blog', href: '/blog' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-brand-bg/85 border-b border-brand-border transition-colors">
  <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5 group">
      <span class="w-8 h-8 rounded-lg bg-brand-card border border-brand-border flex items-center justify-center font-mono font-bold text-xs text-brand-text group-hover:border-brand-accent transition-colors">
        RV
      </span>
      <span class="font-medium text-sm text-brand-text tracking-tight">
        René Villegas
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-xs font-mono uppercase tracking-wider">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="text-brand-muted hover:text-brand-text transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a 
        href="/mantenedor"
        class="hidden sm:inline-flex items-center gap-1 text-xs font-mono text-brand-muted hover:text-brand-accent transition-colors mr-1"
        title="Mantenedor de Noticias & Artículos"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-brand-accent"></span>
        Mantenedor
      </a>

      <a 
        href="/cv-rene-villegas.pdf" 
        download="Curriculum_Vitae_Rene_Villegas.pdf"
        class="inline-flex items-center gap-1.5 text-xs font-mono px-3.5 py-1.5 rounded-lg border border-brand-border bg-brand-card text-brand-text hover:border-brand-accent hover:text-brand-accent transition-all duration-200"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        Descargar CV
      </a>
    </div>
  </div>
</header>
