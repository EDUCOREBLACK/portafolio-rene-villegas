---
const navItems = [
  { label: 'Habilidades', href: '/#habilidades' },
  { label: 'Portafolio', href: '/#portafolio' },
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Trayectoria', href: '/#experiencia' },
  { label: 'Blog & IA', href: '/#blog-ia' },
];
---

<header class="sticky top-2 z-40 w-full px-4 sm:px-6 transition-all duration-300">
  <div class="max-w-5xl mx-auto">
    <div class="relative flex h-14 items-center justify-between gap-3 rounded-2xl bg-gray-900/80 dark:bg-gray-900/80 bg-white/90 backdrop-blur-md px-4 border border-gray-800/80 dark:border-gray-800/80 border-slate-200 shadow-xl">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group">
        <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-indigo-600 to-indigo-400 flex items-center justify-center font-mono font-bold text-xs text-white shadow-md shadow-indigo-500/20 group-hover:scale-105 transition-transform">
          RV
        </span>
        <div class="flex flex-col">
          <span class="font-bold text-sm text-gray-100 dark:text-gray-100 text-slate-800 tracking-tight group-hover:text-indigo-400 transition-colors">
            René Villegas
          </span>
          <span class="text-[10px] font-mono text-gray-400 dark:text-gray-400 text-slate-500 -mt-0.5 hidden sm:inline-block">
            datacenter.core.ops
          </span>
        </div>
      </a>

      <!-- Navigation links -->
      <nav class="hidden md:flex items-center gap-6 text-xs font-mono uppercase tracking-wider">
        {navItems.map((item) => (
          <a 
            href={item.href} 
            class="text-gray-400 dark:text-gray-400 text-slate-600 hover:text-indigo-400 transition-colors"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Controls (Theme Toggle & CV Trigger) -->
      <div class="flex items-center gap-2.5">
        
        <!-- Day / Night Theme Toggle Button -->
        <button 
          id="theme-toggle" 
          type="button" 
          class="w-8 h-8 rounded-xl border border-gray-800 dark:border-gray-800 border-slate-300 bg-gray-950/50 dark:bg-gray-950/50 bg-slate-100 flex items-center justify-center text-gray-400 hover:text-indigo-400 hover:border-indigo-500/50 transition-colors"
          aria-label="Cambiar tema claro/oscuro"
          title="Cambiar tema día/noche"
        >
          <!-- Sun icon (shown in dark) -->
          <svg id="theme-toggle-light-icon" class="w-4 h-4 hidden text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
          <!-- Moon icon (shown in light) -->
          <svg id="theme-toggle-dark-icon" class="w-4 h-4 hidden text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
        </button>

        <!-- Download CV Button (opens CLI Modal) -->
        <button 
          type="button"
          data-open-cli-download
          class="inline-flex items-center gap-1.5 text-xs font-mono px-3.5 py-1.5 rounded-xl btn-pro-primary"
          title="Descargar CV con simulación CLI"
        >
          <span class="text-emerald-300 font-bold">$_</span>
          <span>CV (PDF)</span>
        </button>
      </div>

    </div>
  </div>
</header>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  const lightIcon = document.getElementById('theme-toggle-light-icon');
  const darkIcon = document.getElementById('theme-toggle-dark-icon');

  function updateIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      lightIcon?.classList.remove('hidden');
      darkIcon?.classList.add('hidden');
    } else {
      darkIcon?.classList.remove('hidden');
      lightIcon?.classList.add('hidden');
    }
  }

  updateIcons();

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
    updateIcons();
  });
</script>
