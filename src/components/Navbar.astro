---
const navItems = [
  { label: 'Habilidades', href: '/#habilidades' },
  { label: 'Telemetría', href: '/#telemetria' },
  { label: 'Portafolio', href: '/#portafolio' },
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Trayectoria', href: '/#experiencia' },
];
---

<header class="sticky top-3 z-40 w-full px-4 sm:px-6 transition-all duration-300">
  <div class="max-w-5xl mx-auto">
    <div class="relative flex h-14 items-center justify-between gap-3 rounded-full bg-zinc-950/85 dark:bg-[#090a0f]/85 bg-white/90 backdrop-blur-md px-5 border border-zinc-200 dark:border-white/10 shadow-lg dark:shadow-2xl transition-colors">
      
      <!-- Brand Logo (Minimalist Monochromatic Pill) -->
      <a href="/" class="flex items-center gap-2.5 group">
        <span class="w-8 h-8 rounded-full bg-zinc-900 dark:bg-white text-white dark:text-zinc-950 flex items-center justify-center font-mono font-bold text-xs shadow-sm group-hover:scale-105 transition-transform">
          RV
        </span>
        <div class="flex flex-col">
          <span class="font-bold text-sm text-zinc-900 dark:text-white tracking-tight group-hover:opacity-80 transition-opacity">
            René Villegas
          </span>
        </div>
      </a>

      <!-- Navigation links (Kitu Minimalist Uppercase) -->
      <nav class="hidden md:flex items-center gap-6 text-xs font-mono tracking-wider uppercase">
        {navItems.map((item) => (
          <a 
            href={item.href} 
            class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-white font-medium transition-colors relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1.5px] after:bg-zinc-900 dark:after:bg-white hover:after:w-full after:transition-all"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Controls (Theme Toggle & CV Trigger) -->
      <div class="flex items-center gap-2.5">
        
        <!-- Day / Night Theme Toggle Button -->
        <button 
          id="theme-toggle" 
          type="button" 
          class="w-8 h-8 rounded-full border border-zinc-300 dark:border-white/10 bg-zinc-100 dark:bg-white/5 flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white hover:border-zinc-400 dark:hover:border-white/30 transition-all cursor-pointer shadow-sm"
          aria-label="Alternar entre modo día y modo noche"
          title="Cambiar modo día/noche"
        >
          <!-- Sun icon (shown in dark mode) -->
          <svg id="theme-toggle-light-icon" class="w-4 h-4 hidden text-zinc-200 transform transition-transform hover:rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
          <!-- Moon icon (shown in light mode) -->
          <svg id="theme-toggle-dark-icon" class="w-4 h-4 hidden text-zinc-800 transform transition-transform hover:-rotate-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
        </button>

        <!-- Download CV Button (Kitu B&W Invert Pill) -->
        <a 
          href="/cv-rene-villegas.pdf"
          download="cv-rene-villegas.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-mono px-4 py-1.5 rounded-full btn-kitu-primary cursor-pointer uppercase tracking-wider"
          title="Descargar CV (PDF)"
        >
          <span>CV (PDF)</span>
          <span>↓</span>
        </a>
      </div>

    </div>
  </div>
</header>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  const lightIcon = document.getElementById('theme-toggle-light-icon');
  const darkIcon = document.getElementById('theme-toggle-dark-icon');

  function updateIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      lightIcon?.classList.remove('hidden');
      darkIcon?.classList.add('hidden');
    } else {
      darkIcon?.classList.remove('hidden');
      lightIcon?.classList.add('hidden');
    }
  }

  updateIcons();

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
    updateIcons();
  });
</script>
