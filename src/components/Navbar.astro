---
const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Experiencia', href: '/#experiencia' },
  { label: 'Proyectos', href: '/proyectos' },
  { label: 'Blog', href: '/blog' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-brand-dark/85 border-b border-slate-800/80 transition-all">
  <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 group">
      <span class="w-9 h-9 rounded-lg bg-brand-card border border-brand-accent/40 flex items-center justify-center font-mono font-bold text-brand-accent group-hover:border-brand-accent transition-colors shadow-sm">
        RV
      </span>
      <span class="font-bold text-slate-200 group-hover:text-white tracking-tight hidden sm:inline-block">
        René Villegas
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-7 text-sm font-medium">
      {navItems.map((item, index) => (
        <a 
          href={item.href} 
          class="text-slate-300 hover:text-brand-accent transition-colors"
        >
          <span class="text-brand-accent/80 font-mono text-xs mr-1">0{index + 1}.</span>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a 
        href="/#contacto" 
        class="text-xs sm:text-sm px-4 py-2 rounded border border-brand-accent text-brand-accent hover:bg-brand-accent/10 transition-colors font-medium"
      >
        Contacto
      </a>
    </div>
  </div>
</header>
