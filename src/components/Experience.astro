---
const summaryPoints = [
  {
    title: "Centros de Datos & Operaciones 24/7",
    period: "15+ Años de Trayectoria // Senior Lead Ops",
    description: "Supervisión técnica de infraestructura crítica en 3 Data Centers corporativos (~1.000 Racks a 70% de densidad). Coordinación de cuadrillas 24/7 (20 operadores técnicos), resguardo de SLA 99.999% y resolución N1/N2/N3."
  },
  {
    title: "Gobernanza ITIL & Trazabilidad NetBox DCIM",
    period: "Marco ITIL & Normativas ISO 27001",
    description: "Estandarización de procedimientos (SOPs), planes de contingencia ante desastres (DRP) e integración de NetBox DCIM para inventario vivo, mapeo de cables, puertos y trazabilidad total de reservas y controles de cambio (RFCs)."
  },
  {
    title: "Automatización con Power BI & Agentes IA",
    period: "Power Automate, Power BI, Python & SQL",
    description: "Creación de modelos de alerta temprana ante quiebres de SLA, reducción de tiempos de primera respuesta a < 10 minutos y dashboards analíticos en Power BI para control exhaustivo de desviaciones."
  }
];

const education = [
  { degree: "Ingeniería en Tecnologías de la Información y Telecomunicaciones", institution: "Universidad San Sebastián", status: "Titulado" },
  { degree: "Analista de Sistemas", institution: "Instituto Tecnológico de Chile (ITC)", status: "Titulado" },
  { degree: "Técnico Nivel Medio en Electrónica", institution: "Liceo Politécnico San Luis", status: "Titulado" }
];
---

<section id="experiencia" class="max-w-5xl mx-auto px-6 py-16 border-t border-slate-800/80 dark:border-slate-800/80 border-slate-200 transition-colors">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
    <div>
      <div class="pro-badge mb-2">
        <span class="inline-flex items-center gap-2 bg-gradient-to-r from-cyan-400 to-emerald-400 dark:from-cyan-400 dark:to-emerald-400 from-blue-600 to-cyan-600 bg-clip-text text-transparent text-xs font-mono font-bold tracking-wider uppercase">
          Síntesis Profesional & Liderazgo de Operaciones
        </span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white text-gradient-pro tracking-tight">
        Trayectoria Resumida
      </h2>
    </div>
    
    <button 
      type="button"
      data-open-cli-download
      class="btn-pro-secondary inline-flex items-center gap-2 text-xs font-mono px-4 py-2 rounded-xl self-start sm:self-auto group cursor-pointer shadow-sm"
    >
      <span class="text-emerald-600 dark:text-emerald-400 font-bold">$_</span>
      <span>Ver Detalle en CV Completo (PDF)</span>
      <svg class="w-3.5 h-3.5 text-cyan-600 dark:text-cyan-400 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
      </svg>
    </button>
  </div>

  <!-- 3 Main Pillars -->
  <div class="grid md:grid-cols-3 gap-5 mb-10">
    {summaryPoints.map((item) => (
      <div class="pro-card p-6 rounded-2xl flex flex-col justify-between shadow-sm">
        <div>
          <span class="text-xs font-mono text-cyan-700 dark:text-cyan-400 block mb-2 font-bold">
            {item.period}
          </span>
          <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white mb-2.5">
            {item.title}
          </h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            {item.description}
          </p>
        </div>
      </div>
    ))}
  </div>

  <!-- Educación Compacta -->
  <div class="pro-card p-6 rounded-2xl shadow-sm">
    <h3 class="text-xs font-mono uppercase tracking-wider text-cyan-700 dark:text-cyan-400 mb-4 flex items-center gap-2 font-bold">
      <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
      Formación Universitaria & Técnica
    </h3>
    <div class="grid sm:grid-cols-3 gap-4">
      {education.map((item) => (
        <div class="border-l-2 border-cyan-500/40 pl-3">
          <h4 class="text-xs font-bold text-slate-900 dark:text-white mb-0.5">
            {item.degree}
          </h4>
          <p class="text-[11px] text-slate-600 dark:text-slate-400 font-medium">
            {item.institution} • <span class="text-emerald-700 dark:text-emerald-400 font-mono font-bold">{item.status}</span>
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
