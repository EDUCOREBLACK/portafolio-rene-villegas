---

<section id="experiencia" class="max-w-5xl mx-auto px-6 py-16 border-t border-zinc-200 dark:border-white/10 transition-colors reveal">
  
  <!-- Header de Experiencia Laboral (Kitu Minimalist) -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
    <div>
      <div class="inline-flex items-center gap-2 mb-2 font-mono text-xs uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400 font-semibold">
        <span class="w-2 h-2 rounded-full bg-zinc-900 dark:bg-white animate-pulse"></span>
        <span>Historial Profesional Completo</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-heading font-bold text-zinc-950 dark:text-white tracking-tight">
        Experiencia Laboral
      </h2>
      <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 max-w-2xl mt-1 leading-relaxed">
        Trayectoria cronológica de más de 15 años liderando infraestructuras críticas, salas blancas de Data Center 24/7 y proyectos de ingeniería TI.
      </p>
    </div>
    
    <a 
      href="/cv-rene-villegas.pdf"
      download="cv-rene-villegas.pdf"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-kitu-primary inline-flex items-center gap-2 text-xs font-mono px-5 py-2.5 rounded-full self-start sm:self-auto group cursor-pointer shadow-sm uppercase tracking-wider"
    >
      <span>Descargar CV Completo</span>
      <span>↓</span>
    </a>
  </div>

  <!-- Timeline Cronológico Ejecutivo -->
  <div class="relative border-l border-zinc-200 dark:border-white/10 ml-3 sm:ml-4 pl-6 sm:pl-8 space-y-10 mb-14">
    {workExperience.map((job, index) => (
      <div class={`relative group reveal ${index > 0 ? 'reveal-delay-1' : ''}`}>
        <!-- Indicador de nodo monocromático -->
        <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-3.5 h-3.5 rounded-full bg-white dark:bg-zinc-950 border-2 border-zinc-900 dark:border-white group-hover:scale-125 transition-transform shadow-sm"></div>

        <!-- Tarjeta de Experiencia -->
        <div class="pro-card p-6 sm:p-7 rounded-2xl border border-zinc-200 dark:border-white/10 bg-white dark:bg-[#0f1118] shadow-sm hover:border-zinc-500 dark:hover:border-white/30 transition-colors">
          
          <!-- Encabezado de la posición -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3 pb-3 border-b border-zinc-100 dark:border-white/10">
            <div>
              <span class="text-xs font-mono font-bold text-zinc-500 dark:text-zinc-400 block mb-0.5">
                {job.period}
              </span>
              <h3 class="text-base sm:text-lg font-heading font-bold text-zinc-950 dark:text-white">
                {job.company}
              </h3>
              <p class="text-xs sm:text-sm font-medium text-zinc-700 dark:text-zinc-300">
                {job.role}
              </p>
            </div>

            <span class="self-start sm:self-auto text-[10px] font-mono px-3 py-1 rounded-full bg-zinc-100 dark:bg-white/10 text-zinc-900 dark:text-white border border-zinc-300 dark:border-white/15 font-semibold whitespace-nowrap uppercase tracking-wider">
              {job.badge}
            </span>
          </div>

          <!-- Lista de responsabilidades y logros -->
          <ul class="space-y-2.5 text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed mb-5">
            {job.achievements.map((item) => (
              <li class="flex items-start gap-2.5">
                <span class="text-zinc-900 dark:text-white font-bold mt-0.5 flex-shrink-0 text-xs">▸</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <!-- Tags de tecnologías / herramientas utilizadas -->
          <div class="flex flex-wrap gap-1.5 pt-3 border-t border-zinc-100 dark:border-white/10">
            {job.tags.map((tag) => (
              <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-md bg-zinc-100 dark:bg-white/5 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-white/10">
                {tag}
              </span>
            ))}
          </div>

        </div>
      </div>
    ))}
  </div>

  <!-- Formación Académica -->
  <div class="pt-8 border-t border-zinc-200 dark:border-white/10 reveal">
    <div class="flex items-center gap-2 mb-6">
      <span class="text-base">🎓</span>
      <h3 class="text-xs font-mono uppercase tracking-[0.2em] text-zinc-700 dark:text-zinc-300 font-bold">
        Formación Académica & Titulaciones
      </h3>
    </div>

    <div class="grid sm:grid-cols-3 gap-4">
      {education.map((item) => (
        <div class="p-5 rounded-2xl border border-zinc-200 dark:border-white/10 bg-white dark:bg-[#0f1118] shadow-sm">
          <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-zinc-100 dark:bg-white/10 text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-white/15 font-semibold inline-block mb-3">
            {item.status}
          </span>
          <h4 class="text-sm font-bold text-zinc-950 dark:text-white mb-1.5">
            {item.degree}
          </h4>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">
            {item.institution}
          </p>
        </div>
      ))}
    </div>
  </div>

</section>
