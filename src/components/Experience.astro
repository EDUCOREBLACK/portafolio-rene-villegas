---
const summaryPoints = [
  {
    title: "Centros de Datos & Operaciones 24/7",
    period: "15+ Años",
    description: "Supervisión técnica y aseguramiento de continuidad en infraestructuras de misión crítica. Gestión de disponibilidad en plataformas corporativas resguardando SLAs de alta exigencia."
  },
  {
    title: "Gobernanza Operacional & Continuidad (DRP)",
    period: "Marco ITIL & ISO 27001",
    description: "Gestión sistemática de incidentes, procedimientos operativos estándar (SOPs), planes de contingencia DRP y preparación para auditorías de seguridad física y de datos."
  },
  {
    title: "Desarrollo de Software & Automatización",
    period: "Python, SQL, APIs, IA",
    description: "Desarrollo de aplicaciones empresariales, pipelines para conciliación de inventarios tecnológicos, auditorías de activos y herramientas asistidas por Inteligencia Artificial."
  }
];

const education = [
  { degree: "Ingeniería en Tecnologías de la Información y Telecomunicaciones", institution: "Universidad San Sebastián", status: "Titulado" },
  { degree: "Analista de Sistemas", institution: "Instituto Tecnológico de Chile (ITC)", status: "Titulado" },
  { degree: "Técnico Nivel Medio en Electrónica", institution: "Liceo Politécnico San Luis", status: "Titulado" }
];
---

<section id="experiencia" class="max-w-5xl mx-auto px-6 py-16 border-t border-brand-border/60">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
    <div>
      <p class="text-xs font-mono uppercase tracking-widest text-brand-accent mb-2">Síntesis Profesional</p>
      <h2 class="text-2xl sm:text-3xl font-bold text-brand-text">Trayectoria Resumida</h2>
    </div>
    
    <a 
      href="/cv-rene-villegas.pdf" 
      download="Curriculum_Vitae_Rene_Villegas.pdf"
      class="inline-flex items-center gap-1.5 text-xs font-mono px-3.5 py-1.5 rounded-lg border border-brand-border bg-brand-card hover:border-brand-accent hover:text-brand-accent text-brand-text transition-all self-start sm:self-auto"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
      <span>Ver Detalle en CV Completo (PDF)</span>
    </a>
  </div>

  <div class="grid md:grid-cols-3 gap-5 mb-10">
    {summaryPoints.map((item) => (
      <div class="bg-brand-card p-5 rounded-xl border border-brand-border flex flex-col justify-between">
        <div>
          <span class="text-[11px] font-mono text-brand-accent block mb-2">
            {item.period}
          </span>
          <h3 class="text-sm font-bold text-brand-text mb-2">
            {item.title}
          </h3>
          <p class="text-xs text-brand-muted leading-relaxed">
            {item.description}
          </p>
        </div>
      </div>
    ))}
  </div>

  <!-- Educación Compacta -->
  <div class="p-5 rounded-xl border border-brand-border bg-brand-card/60">
    <h3 class="text-xs font-mono uppercase tracking-wider text-brand-muted mb-3 flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-brand-accent"></span>
      Formación Universitaria & Técnica
    </h3>
    <div class="grid sm:grid-cols-3 gap-3">
      {education.map((item) => (
        <div>
          <h4 class="text-xs font-semibold text-brand-text">
            {item.degree}
          </h4>
          <p class="text-[11px] text-brand-muted">
            {item.institution} • <span class="text-brand-accent">{item.status}</span>
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
