---
const summaryPoints = [
  {
    title: "Centros de Datos & Operaciones 24/7",
    period: "15+ Años de Trayectoria",
    description: "Supervisión técnica directa y garantía de continuidad en infraestructuras de misión crítica. Gestión de incidentes y disponibilidad en plataformas corporativas resguardando estrictos SLAs (99.999%)."
  },
  {
    title: "Gobernanza Operacional & Continuidad (DRP)",
    period: "Marco ITIL & Normativas ISO 27001",
    description: "Diseño y aplicación sistemática de procedimientos operativos estándar (SOPs), planes de contingencia ante desastres (DRP) y preparación para auditorías de seguridad física y lógica."
  },
  {
    title: "Desarrollo de Software & Automatización",
    period: "Python, SQL, APIs & IA",
    description: "Construcción de software a medida, conciliación de inventarios tecnológicos, automatizaciones de procesos con agentes inteligentes y dashboards de analítica de datos."
  }
];

const education = [
  { degree: "Ingeniería en Tecnologías de la Información y Telecomunicaciones", institution: "Universidad San Sebastián", status: "Titulado" },
  { degree: "Analista de Sistemas", institution: "Instituto Tecnológico de Chile (ITC)", status: "Titulado" },
  { degree: "Técnico Nivel Medio en Electrónica", institution: "Liceo Politécnico San Luis", status: "Titulado" }
];
---

<section id="experiencia" class="max-w-5xl mx-auto px-6 py-16 border-t border-gray-800/80">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12 gap-4">
    <div>
      <div class="pro-badge mb-2">
        <span class="bg-gradient-to-r from-indigo-400 to-indigo-200 bg-clip-text text-transparent text-xs font-mono font-semibold tracking-wider uppercase">
          Síntesis Profesional
        </span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-bold text-gradient-pro">
        Trayectoria Resumida
      </h2>
    </div>
    
    <button 
      type="button"
      data-open-cli-download
      class="btn-pro-secondary inline-flex items-center gap-2 text-xs font-mono px-4 py-2 rounded-xl self-start sm:self-auto group"
    >
      <span class="text-emerald-400 font-bold">$_</span>
      <span>Ver Detalle en CV Completo (PDF)</span>
      <svg class="w-3.5 h-3.5 text-indigo-400 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
      </svg>
    </button>
  </div>

  <!-- 3 Main Pillars -->
  <div class="grid md:grid-cols-3 gap-5 mb-10">
    {summaryPoints.map((item) => (
      <div class="pro-card p-6 rounded-2xl border border-gray-800/80 flex flex-col justify-between">
        <div>
          <span class="text-xs font-mono text-indigo-400 block mb-2 font-semibold">
            {item.period}
          </span>
          <h3 class="text-sm sm:text-base font-bold text-gray-100 mb-2.5">
            {item.title}
          </h3>
          <p class="text-xs text-gray-400 leading-relaxed">
            {item.description}
          </p>
        </div>
      </div>
    ))}
  </div>

  <!-- Educación Compacta -->
  <div class="pro-card p-6 rounded-2xl border border-gray-800/80">
    <h3 class="text-xs font-mono uppercase tracking-wider text-indigo-400 mb-4 flex items-center gap-2 font-semibold">
      <span class="w-2 h-2 rounded-full bg-indigo-500"></span>
      Formación Universitaria & Técnica
    </h3>
    <div class="grid sm:grid-cols-3 gap-4">
      {education.map((item) => (
        <div class="border-l-2 border-indigo-500/40 pl-3">
          <h4 class="text-xs font-bold text-gray-200 mb-0.5">
            {item.degree}
          </h4>
          <p class="text-[11px] text-gray-400">
            {item.institution} • <span class="text-emerald-400 font-mono font-semibold">{item.status}</span>
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
